+// A process outlives any one request: the router cuts every stream, and the
+// client resumes output at the delivered offsets and stdin on the next write.
+// Input written after the streams sat idle through several cuts must arrive,
+// and output must arrive exactly once. Envoy reports a cut differently for
+// its route timeout and its stream idle timeout; both must resume.
+func TestProcessStreamsSurviveRouterCuts(t *testing.T) {
+	for name, idle := range map[string]bool{"route timeout": false, "stream idle timeout": true} {
+		t.Run(name, func(t *testing.T) {
+			testProcessStreamsSurviveCuts(t, idle)
+		})
+	}
+}
+
+func testProcessStreamsSurviveCuts(t *testing.T, cutAsIdleTimeout bool) {
+	const routeTimeout = 300 * time.Millisecond
+	f := newFixtureWithRouter(t, func(r *fakerouter.Router) {
+		r.RouteTimeout = routeTimeout
+		r.CutAsIdleTimeout = cutAsIdleTimeout
+	})
+	sb := f.create(t, "sb-cut")
+	ctx := t.Context()
+
+	proc, err := sb.StartProcess(ctx, &ateenvv1alpha.StartProcessRequest{Command: []string{"cat"}, Stdin: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	type followed struct {
+		exit *ateenvv1alpha.Process
+		err  error
+	}
+	lines := make(chan string, 8)
+	done := make(chan followed, 1)
+	go func() {
+		var partial string
+		exit, err := proc.Follow(ctx, func(msg *ateenvv1alpha.ProcessOutput) error {
+			partial += string(msg.GetStdout())
+			for {
+				line, rest, ok := strings.Cut(partial, "\n")
+				if !ok {
+					return nil
+				}
+				lines <- line
+				partial = rest
+			}
+		})
+		done <- followed{exit, err}
+	}()
+	expectLine := func(want string) {
+		t.Helper()
+		select {
+		case got := <-lines:
+			if got != want {
+				t.Fatalf("output line = %q, want %q", got, want)
+			}
+		case r := <-done:
+			t.Fatalf("follow ended before %q: exit=%v err=%v", want, r.exit, r.err)
+		case <-time.After(10 * time.Second):
+			t.Fatalf("no output line %q", want)
+		}
+	}
+
+	stdin, err := proc.Stdin(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range []string{"one", "two", "three"} {
+		if _, err := stdin.Write([]byte(line + "\n")); err != nil {
+			t.Fatalf("writing %q: %v", line, err)
+		}
+		expectLine(line)
+		time.Sleep(3 * routeTimeout) // both streams idle across several cuts
+	}
+	if err := stdin.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case r := <-done:
+		if r.err != nil {
+			t.Fatalf("follow: %v", r.err)
+		}
+		if r.exit.GetState() != ateenvv1alpha.ProcessState_PROCESS_STATE_EXITED || r.exit.GetExitCode() != 0 {
+			t.Errorf("exit = %v, want exited with 0", r.exit)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("follow did not end after stdin closed")
+	}
+	select {
+	case extra := <-lines:
+		t.Errorf("output delivered more than once: extra line %q", extra)
+	default:
+	}
+
+	res, err := sb.Run(ctx, env.ShellRequest{Command: "echo start; sleep 1; echo done"})
+	if err != nil {
+		t.Fatalf("run outlasting the route timeout: %v", err)
+	}
+	if res.Stdout != "start\ndone\n" || res.ExitCode != 0 {
+		t.Errorf("run result = %+v, want stdout %q", res, "start\ndone\n")
+	}
+}
