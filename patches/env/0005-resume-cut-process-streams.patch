+// limitations under the License.
+
+package env
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// Process streams outlive the path that carries them. The atenet router bounds
+// every request with its route timeout, and port-forwards, router rollouts and
+// a sleeping laptop cut streams as well. The guest keeps a process running
+// across all of that: output stays spooled and addressable by byte offset, and
+// stdin accepts any number of input streams. So a cut stream is not a process
+// failure, and the client reopens it where it left off instead of surfacing
+// the cut to the caller.
+
+const (
+	// reconnectAttemptsMax bounds the probes after one cut, and the cuts in a
+	// row that make no progress. Each probe may itself wait out ate-env-api's
+	// wake budget while a suspended actor resumes, so this is a count, not a
+	// duration.
+	reconnectAttemptsMax = 5
+	// streamLifetimeMin separates a cut from a failure that repeats: a route
+	// timeout cuts a stream that has been open for minutes, while a stream
+	// that fails again within this time of opening, having delivered
+	// nothing, made no progress.
+	streamLifetimeMin       = time.Second
+	reconnectBackoffInitial = 200 * time.Millisecond
+	reconnectBackoffMax     = 2 * time.Second
+)
+
+// resumable reports whether err may be a cut path rather than an answer from
+// the guest. The guest answers with typed codes (NotFound, FailedPrecondition,
+// InvalidArgument, ...), which are final. A cut path shows up untyped:
+//   - Unavailable: a route timeout before any response, a refused
+//     connection, an actor that is still waking.
+//   - Internal: a route timeout on a stream that is already answering, sent
+//     as an HTTP/2 reset.
+//   - Unknown: Envoy's stream idle timeout, an HTTP 408 without gRPC status.
+//
+// A broken guest could also answer Internal or Unknown, so the reconnect
+// bounds, not this classification, keep that from looping.
+func resumable(err error) bool {
+	switch status.Code(err) {
+	case codes.Unavailable, codes.Internal, codes.Unknown:
+		return true
+	}
+	return false
+}
+
+// reconnect waits until the process is reachable again after a stream was cut
+// with cut. The probe is a GetProcess call, which also wakes a suspended
+// actor through ate-env-api. Probing first, rather than reopening the stream
+// blindly, separates a routine cut (the probe answers at once) from a path
+// that stays down (the probes run out), so an idle stream that is cut on every
+// route timeout never exhausts the bound.
+func (p *Process) reconnect(ctx context.Context, cut error) error {
+	if !resumable(cut) {
+		return cut
+	}
+	backoff := reconnectBackoffInitial
+	last := cut
+	for attempt := 1; attempt <= reconnectAttemptsMax; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		_, err := p.env.FindProcess(ctx, p.id)
+		if err == nil {
+			return nil
+		}
+		if !resumable(err) {
+			return err
+		}
+		last = err
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(backoff):
+		}
+		backoff = min(backoff*2, reconnectBackoffMax)
+	}
+	return fmt.Errorf("env: process %s unreachable after %d reconnect attempts: %w", p.id, reconnectAttemptsMax, last)
+}
