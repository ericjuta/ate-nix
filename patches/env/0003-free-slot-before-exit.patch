Free the process slot before the exit becomes visible.

reap published the exit (state, done channel) before it decremented the
active count, so a client that saw a process exit and started another at
once could get ResourceExhausted. Upstream TestConcurrencyLimiter fails
this way on a loaded machine.

diff --git a/guest/process/tracker.go b/guest/process/tracker.go
index 5c093db..c284825 100644
--- a/guest/process/tracker.go
+++ b/guest/process/tracker.go
@@ -465,6 +465,10 @@ func (t *Tracker) reap(state *ProcessState, cmd *exec.Cmd, stdoutFile, stderrFil
 	_ = stdoutFile.Close()
 	_ = stderrFile.Close()
 
+	// Free the slot before the exit is visible, so a client that sees the
+	// exit can start a replacement at once.
+	t.decrementActive()
+
 	state.mu.Lock()
 	if state.timer != nil {
 		state.timer.Stop()
@@ -480,7 +484,6 @@ func (t *Tracker) reap(state *ProcessState, cmd *exec.Cmd, stdoutFile, stderrFil
 
 	close(state.done)
 	state.output.notify()
-	t.decrementActive()
 }
 
 // exitStatus decodes how a waited process ended: (code, 0) for a normal
