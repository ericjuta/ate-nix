+func TestPtyCombinesStreamsAndResizes(t *testing.T) {
+	client := setupTestServer(t)
+	ctx := context.Background()
+	started := start(t, client, &ateenvv1alpha.StartProcessRequest{
+		Command:     []string{"sh", "-c", "stty size; printf out; printf err >&2; cat"},
+		Stdin:       true,
+		Pty:         true,
+		InitialSize: &ateenvv1alpha.TermSize{Rows: 31, Cols: 93},
+	})
+	in, err := client.WriteProcessInput(ctx)
+	if err != nil {
+		t.Fatalf("WriteProcessInput: %v", err)
+	}
+	if err := in.Send(&ateenvv1alpha.WriteProcessInputRequest{ProcessId: started.GetProcessId(), Data: []byte("\x04")}); err != nil {
+		t.Fatalf("send: %v", err)
+	}
+	if _, err := in.CloseAndRecv(); err != nil {
+		t.Fatalf("CloseAndRecv: %v", err)
+	}
+
+	stdout, stderr, exit := collect(t, client, &ateenvv1alpha.StreamProcessOutputRequest{ProcessId: started.GetProcessId(), Follow: true})
+	if !strings.Contains(stdout, "31 93") {
+		t.Fatalf("PTY did not report the initial size in stdout %q", stdout)
+	}
+	if _, err := client.ResizeProcess(ctx, &ateenvv1alpha.ResizeProcessRequest{ProcessId: started.GetProcessId(), Rows: 32, Cols: 94}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("expected FailedPrecondition resizing an exited PTY, got %v", err)
+	}
+	if !strings.Contains(stdout, "outerr") {
+		t.Fatalf("PTY did not combine stdout/stderr into the raw stdout stream: %q", stdout)
+	}
+	if stderr != "" {
+		t.Fatalf("PTY stderr stream must be unused, got %q", stderr)
+	}
+	if exit.GetExitCode() != 0 {
+		t.Fatalf("PTY command exit = %d", exit.GetExitCode())
+	}
+}
