+func runTTYShell(ctx context.Context, e *env.Env, commandLine string, timeout time.Duration, suspendOnOSC7501Inactive bool) error {
+	fd := int(os.Stdin.Fd())
+	if !term.IsTerminal(fd) {
+		return errors.New("--tty requires stdin to be a terminal")
+	}
+	width, height, err := term.GetSize(fd)
+	if err != nil {
+		return fmt.Errorf("reading terminal size: %w", err)
+	}
+	start := &ateenvv1alpha.StartProcessRequest{
+		Command:     []string{"sh", "-c", commandLine},
+		Stdin:       true,
+		Pty:         true,
+		InitialSize: &ateenvv1alpha.TermSize{Rows: uint32(height), Cols: uint32(width)},
+	}
+	if timeout > 0 {
+		start.Timeout = durationpb.New(timeout)
+	}
+	proc, err := e.StartProcess(ctx, start)
+	if err != nil {
+		return err
+	}
+	oldState, err := term.MakeRaw(fd)
+	if err != nil {
+		_, _ = proc.Kill(context.WithoutCancel(ctx))
+		return fmt.Errorf("entering raw mode: %w", err)
+	}
+	defer func() { _ = term.Restore(fd, oldState) }()
+
+	stdin, err := proc.Stdin(ctx)
+	if err != nil {
+		_, _ = proc.Kill(context.WithoutCancel(ctx))
+		return err
+	}
+	defer stdin.Close()
+
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	errCh := make(chan error, 4)
+	var osc7501InactiveSeen atomic.Bool
+
+	go func() {
+		_, err := io.Copy(stdin, os.Stdin)
+		if err != nil && !errors.Is(err, os.ErrClosed) {
+			errCh <- err
+		}
+	}()
+	go func() {
+		stream, err := proc.Output(ctx, &ateenvv1alpha.StreamProcessOutputRequest{Follow: true})
+		if err != nil {
+			errCh <- err
+			return
+		}
+		var osc7501 osc7501Tracker
+		for {
+			msg, err := stream.Recv()
+			if errors.Is(err, io.EOF) {
+				return
+			}
+			if err != nil {
+				errCh <- err
+				return
+			}
+			switch out := msg.GetOutput().(type) {
+			case *ateenvv1alpha.ProcessOutput_Stdout:
+				if _, err := os.Stdout.Write(out.Stdout); err != nil {
+					errCh <- err
+					return
+				}
+				if suspendOnOSC7501Inactive && osc7501.inactive(out.Stdout) {
+					osc7501InactiveSeen.Store(true)
+				}
+			case *ateenvv1alpha.ProcessOutput_Stderr:
+				if _, err := os.Stderr.Write(out.Stderr); err != nil {
+					errCh <- err
+					return
+				}
+			case *ateenvv1alpha.ProcessOutput_Exit:
+				if out.Exit.GetExitCode() != 0 {
+					os.Exit(int(out.Exit.GetExitCode()))
+				}
+				return
+			}
+		}
+	}()
+	go func() {
+		sigCh := make(chan os.Signal, 1)
+		signal.Notify(sigCh, syscall.SIGWINCH)
+		defer signal.Stop(sigCh)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-sigCh:
+				width, height, err := term.GetSize(fd)
+				if err != nil {
+					errCh <- fmt.Errorf("reading terminal size: %w", err)
+					return
+				}
+				if err := proc.Resize(ctx, uint32(height), uint32(width)); err != nil {
+					errCh <- err
+					return
+				}
+			}
+		}
+	}()
+
+	exit, err := proc.Wait(ctx)
+	cancel()
+	if err != nil {
+		select {
+		case streamErr := <-errCh:
+			return streamErr
+		default:
+			return err
+		}
+	}
+	select {
+	case asyncErr := <-errCh:
+		return asyncErr
+	default:
+	}
+	if exit.GetExitCode() != 0 {
+		os.Exit(int(exit.GetExitCode()))
+	}
+	if suspendOnOSC7501Inactive && osc7501InactiveSeen.Load() {
+		if err := e.Suspend(context.WithoutCancel(ctx)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+type osc7501Tracker struct {
+	buffer string
+}
+
+func (t *osc7501Tracker) inactive(data []byte) bool {
+	const maxBuffered = 4096
+	t.buffer += string(data)
+	if len(t.buffer) > maxBuffered {
+		t.buffer = t.buffer[len(t.buffer)-maxBuffered:]
+	}
+	return osc7501Inactive(t.buffer)
+}
+
+func osc7501Inactive(text string) bool {
+	const prefix = "\x1b]7501;"
+	for {
+		start := strings.Index(text, prefix)
+		if start < 0 {
+			return false
+		}
+		rest := text[start+len(prefix):]
+		end := strings.Index(rest, "\x1b\\")
+		if end < 0 {
+			return false
+		}
+		payload := rest[:end]
+		if osc7501PayloadInactive(payload) {
+			return true
+		}
+		text = rest[end+2:]
+	}
+}
+
+func osc7501PayloadInactive(payload string) bool {
+	parts := strings.Split(payload, ";")
+	if len(parts) < 1 {
+		return false
+	}
+	if parts[0] != "app=omp" && parts[0] != "omp" {
+		return false
+	}
+	for _, part := range parts[1:] {
+		key, value, ok := strings.Cut(part, "=")
+		if !ok {
+			continue
+		}
+		decoded, err := url.QueryUnescape(value)
+		if err != nil {
+			decoded = value
+		}
+		key = strings.TrimSpace(strings.ToLower(key))
+		decoded = strings.TrimSpace(strings.ToLower(decoded))
+		switch key {
+		case "active", "sessionactive", "session-active", "session_active":
+			if decoded == "false" || decoded == "0" || decoded == "no" || decoded == "not active" || decoded == "inactive" {
+				return true
+			}
+		case "state", "status":
+			if decoded == "not active" || decoded == "inactive" || decoded == "idle" || decoded == "done" {
+				return true
+			}
+		}
+	}
+	return false
+}
