+type testCA struct {
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+	pem  []byte
+}
+
+var testSerial int64
+
+func newTestCA(t *testing.T, name string) testCA {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	testSerial++
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(testSerial),
+		Subject:               pkix.Name{CommonName: name},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return testCA{cert: cert, key: key, pem: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})}
+}
+
+// issue returns a leaf signed by ca as a PEM bundle (certificate then key),
+// the layout of a projected podCertificate credential bundle, and its serial.
+func (ca testCA) issue(t *testing.T, usage x509.ExtKeyUsage, dnsName string) ([]byte, tls.Certificate, *big.Int) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	testSerial++
+	serial := big.NewInt(testSerial)
+	template := &x509.Certificate{
+		SerialNumber: serial,
+		Subject:      pkix.Name{CommonName: "leaf"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{usage},
+	}
+	if dnsName != "" {
+		template.DNSNames = []string{dnsName}
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, ca.cert, &key.PublicKey, ca.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalECPrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certPEM := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	keyPEM := pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: keyDER})
+	pair, err := tls.X509KeyPair(certPEM, keyPEM)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return append(certPEM, keyPEM...), pair, serial
+}
+
+// swapFile replaces path the way the kubelet atomic writer does: the new
+// content appears under the same path in one rename.
+func swapFile(t *testing.T, path string, data []byte) {
+	t.Helper()
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// handshake runs one client handshake through creds against
+// a server presenting serving and requiring a client certificate from
+// clientCA. It returns the serial of the client certificate the server saw.
+func handshake(t *testing.T, creds credentials.TransportCredentials, serving tls.Certificate, clientCA testCA) (*big.Int, error) {
+	t.Helper()
+	clientCAs := x509.NewCertPool()
+	clientCAs.AddCert(clientCA.cert)
+	listener, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{
+		Certificates: []tls.Certificate{serving},
+		ClientAuth:   tls.RequireAndVerifyClientCert,
+		ClientCAs:    clientCAs,
+		MinVersion:   tls.VersionTLS12,
+		NextProtos:   []string{"h2"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	seen := make(chan *big.Int, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			seen <- nil
+			return
+		}
+		defer conn.Close()
+		tlsConn := conn.(*tls.Conn)
+		if tlsConn.Handshake() != nil || len(tlsConn.ConnectionState().PeerCertificates) == 0 {
+			seen <- nil
+			return
+		}
+		seen <- tlsConn.ConnectionState().PeerCertificates[0].SerialNumber
+	}()
+	raw, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, _, err := creds.ClientHandshake(ctx, ate.RouterServerName, raw)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	return <-seen, nil
+}
+
+func TestRouterTLSCredentialsFollowsRotatedCertificateAndTrustBundle(t *testing.T) {
+	dir := t.TempDir()
+	bundlePath := filepath.Join(dir, "credential-bundle.pem")
+	caPath := filepath.Join(dir, "router-ca.pem")
+
+	clientCA := newTestCA(t, "podidentity")
+	routerCA1 := newTestCA(t, "servicedns-1")
+	_, serving1, _ := routerCA1.issue(t, x509.ExtKeyUsageServerAuth, ate.RouterServerName)
+	bundle1, _, serial1 := clientCA.issue(t, x509.ExtKeyUsageClientAuth, "")
+	swapFile(t, bundlePath, bundle1)
+	swapFile(t, caPath, routerCA1.pem)
+
+	r, err := ate.RouterTLSCredentials(bundlePath, caPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := handshake(t, r, serving1, clientCA)
+	if err != nil {
+		t.Fatalf("initial handshake: %v", err)
+	}
+	if got.Cmp(serial1) != 0 {
+		t.Fatalf("server saw client serial %v, want %v", got, serial1)
+	}
+
+	// The kubelet rotates the pod certificate: the next handshake on the
+	// same credentials presents the new one.
+	bundle2, _, serial2 := clientCA.issue(t, x509.ExtKeyUsageClientAuth, "")
+	swapFile(t, bundlePath, bundle2)
+	got, err = handshake(t, r, serving1, clientCA)
+	if err != nil {
+		t.Fatalf("handshake after client rotation: %v", err)
+	}
+	if got.Cmp(serial2) != 0 {
+		t.Fatalf("server saw client serial %v after rotation, want %v", got, serial2)
+	}
+
+	// The trust bundle rotates to a new router CA: the router's new serving
+	// certificate is trusted and one from the retired CA no longer is.
+	routerCA2 := newTestCA(t, "servicedns-2")
+	_, serving2, _ := routerCA2.issue(t, x509.ExtKeyUsageServerAuth, ate.RouterServerName)
+	swapFile(t, caPath, routerCA2.pem)
+	if _, err := handshake(t, r, serving2, clientCA); err != nil {
+		t.Fatalf("handshake after trust bundle rotation: %v", err)
+	}
+	if _, err := handshake(t, r, serving1, clientCA); err == nil {
+		t.Fatal("handshake trusted a router certificate from the retired CA")
+	}
+}
+
+func TestRouterTLSCredentialsRejectsUntrustedOrMisnamedRouter(t *testing.T) {
+	dir := t.TempDir()
+	bundlePath := filepath.Join(dir, "credential-bundle.pem")
+	caPath := filepath.Join(dir, "router-ca.pem")
+
+	clientCA := newTestCA(t, "podidentity")
+	routerCA := newTestCA(t, "servicedns")
+	bundle, _, _ := clientCA.issue(t, x509.ExtKeyUsageClientAuth, "")
+	swapFile(t, bundlePath, bundle)
+	swapFile(t, caPath, routerCA.pem)
+	r, err := ate.RouterTLSCredentials(bundlePath, caPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	_, untrusted, _ := newTestCA(t, "other").issue(t, x509.ExtKeyUsageServerAuth, ate.RouterServerName)
+	_, misnamed, _ := routerCA.issue(t, x509.ExtKeyUsageServerAuth, "other.ate-system.svc")
+	_, clientOnly, _ := routerCA.issue(t, x509.ExtKeyUsageClientAuth, ate.RouterServerName)
+	for name, serving := range map[string]tls.Certificate{
+		"untrusted CA":       untrusted,
+		"wrong DNS name":     misnamed,
+		"no server auth EKU": clientOnly,
+	} {
+		if _, err := handshake(t, r, serving, clientCA); err == nil {
+			t.Errorf("%s: handshake succeeded", name)
+		}
+	}
+}
