+// routerTLS caches the parsed router credentials by file content.
+type routerTLS struct {
+	bundlePath string
+	caPath     string
+
+	mu        sync.Mutex
+	bundlePEM []byte
+	caPEM     []byte
+	cert      *tls.Certificate
+	roots     *x509.CertPool
+}
+
+func (r *routerTLS) clientCertificate() (*tls.Certificate, error) {
+	data, err := os.ReadFile(r.bundlePath)
 	if err != nil {
 		return nil, fmt.Errorf("ate: reading router credential bundle: %w", err)
 	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.cert != nil && bytes.Equal(data, r.bundlePEM) {
+		return r.cert, nil
+	}
