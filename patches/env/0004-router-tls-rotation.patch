 	if err != nil {
-		return nil, errors.Join(fmt.Errorf("ate: parsing router credential bundle %s", path), err)
+		return nil, errors.Join(fmt.Errorf("ate: parsing router credential bundle %s", r.bundlePath), err)
+	}
+	r.bundlePEM, r.cert = data, &cert
+	return r.cert, nil
+}
+
+func (r *routerTLS) trustRoots() (*x509.CertPool, error) {
+	data, err := os.ReadFile(r.caPath)
+	if err != nil {
+		return nil, fmt.Errorf("ate: reading router CA bundle: %w", err)
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.roots != nil && bytes.Equal(data, r.caPEM) {
+		return r.roots, nil
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(data) {
+		return nil, fmt.Errorf("ate: router CA bundle %s holds no certificates", r.caPath)
+	}
+	r.caPEM, r.roots = data, roots
+	return r.roots, nil
+}
+
+// verifyConnection is the verification crypto/tls performs when
+// InsecureSkipVerify is false: the peer chain must reach a trusted root and
+// the leaf must be valid for ServerName and for server authentication.
+func (r *routerTLS) verifyConnection(state tls.ConnectionState) error {
+	if len(state.PeerCertificates) == 0 {
+		return errors.New("ate: atenet router presented no certificate")
+	}
+	roots, err := r.trustRoots()
+	if err != nil {
+		return err
+	}
+	intermediates := x509.NewCertPool()
+	for _, cert := range state.PeerCertificates[1:] {
+		intermediates.AddCert(cert)
 	}
-	return &cert, nil
+	_, err = state.PeerCertificates[0].Verify(x509.VerifyOptions{
+		DNSName:       state.ServerName,
+		Roots:         roots,
+		Intermediates: intermediates,
+		KeyUsages:     []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	})
+	return err
 }
