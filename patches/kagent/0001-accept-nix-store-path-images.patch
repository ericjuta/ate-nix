diff --git a/go/core/internal/image/validation.go b/go/core/internal/image/validation.go
index a59ffb1..8bc86e9 100644
--- a/go/core/internal/image/validation.go
+++ b/go/core/internal/image/validation.go
@@ -2,9 +2,12 @@ package image
 
 import "regexp"
 
-var digestPinned = regexp.MustCompile(`^[^[:space:]@]+@sha256:[a-f0-9]{64}$`)
+// A Nix store path is content-addressed by its hash prefix, so ate-nix's
+// `nix:/nix/store/<hash>-<name>` reference is as immutable as an OCI digest.
+var digestPinned = regexp.MustCompile(`^([^[:space:]@]+@sha256:[a-f0-9]{64}|nix:/nix/store/[0-9a-z]{32}-[^[:space:]/]+)$`)
 
-// IsDigestPinned reports whether reference names an image pinned by SHA-256 digest.
+// IsDigestPinned reports whether reference names an immutable image: an OCI
+// reference pinned by SHA-256 digest, or a Nix store path.
 func IsDigestPinned(reference string) bool {
 	return digestPinned.MatchString(reference)
 }
