+# Copyright 2026 Google LLC
+# SPDX-License-Identifier: Apache-2.0
+
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+
+# No local object store, local registry, or monitoring CRDs/controllers.
+# PostgreSQL, sandbox configuration, and pod certificates have their own steps.
+# The installer composes the existing-cluster component on every apply path,
+# including targeted redeploys, instead of only patching this full bundle.
+resources:
+  - ../ate-api-server.yaml
+  - ../ate-idp-server.yaml
+  - ../ate-controller.yaml
+  - ../atelet.yaml
+  - ../atenet-router.yaml
+  - ../ate-system-networkpolicies.yaml
+  - ate-otel-config.yaml
