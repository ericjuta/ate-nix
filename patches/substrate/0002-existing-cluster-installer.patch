@@ -0,0 +1,143 @@
+// Copyright 2026 Google LLC
+// SPDX-License-Identifier: Apache-2.0
+
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestExistingClusterSelection(t *testing.T) {
+	for _, channel := range []string{"flag", "environment", "file"} {
+		t.Run(channel, func(t *testing.T) {
+			loadEnv(t)
+			unsetEnv(t, SourceRootEnv)
+			unsetEnv(t, "ATE_EXISTING_CLUSTER")
+			fakeRepo(t)
+			fs := optionsFlagSetForTest(t)
+			opts := LoadOptions{}
+			switch channel {
+			case "flag":
+				if err := fs.Set("existing-cluster", "true"); err != nil {
+					t.Fatal(err)
+				}
+			case "environment":
+				t.Setenv("ATE_EXISTING_CLUSTER", "true")
+			case "file":
+				opts.ConfigPath = writeConfig(t, validHeader+"existingCluster:\n  enabled: true\n")
+			}
+			cfg, err := LoadFlags(fs, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !cfg.ExistingCluster || cfg.Kind {
+				t.Fatalf("ExistingCluster=%v Kind=%v", cfg.ExistingCluster, cfg.Kind)
+			}
+			if cfg.Context != "" || cfg.KODockerRepo != "" || cfg.SnapshotLocation != "" {
+				t.Fatalf("existing cluster acquired Kind defaults: context=%q repo=%q snapshots=%q", cfg.Context, cfg.KODockerRepo, cfg.SnapshotLocation)
+			}
+			if cfg.shellEnv[devEnvMarker] != "" {
+				t.Fatal("existing-cluster mode sourced the GKE developer environment")
+			}
+		})
+	}
+}
+
+func TestExistingClusterFalseOverridesEnvironment(t *testing.T) {
+	loadEnv(t)
+	t.Setenv("ATE_EXISTING_CLUSTER", "true")
+	fs := optionsFlagSetForTest(t)
+	if err := fs.Set("existing-cluster", "false"); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := LoadFlags(fs, LoadOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ExistingCluster {
+		t.Fatal("--existing-cluster=false did not outrank the environment")
+	}
+}
+
+func TestExistingClusterRejectsKind(t *testing.T) {
+	loadEnv(t)
+	t.Setenv("ATE_EXISTING_CLUSTER", "true")
+	_, err := Load(Options{Kind: true})
+	if err == nil || !strings.Contains(err.Error(), "distinct install profiles") {
+		t.Fatalf("error=%v, want conflicting profiles", err)
+	}
+}
+
+func TestExistingClusterDoesNotFetchCloudCredentials(t *testing.T) {
+	t.Setenv("PATH", t.TempDir())
+	cfg := Config{ExistingCluster: true, ProjectID: "ambient-project", ClusterName: "ambient-cluster", ClusterLocation: "ambient-location", TransferGSAName: "ambient-account"}
+	if err := cfg.EnsureClusterCredentials(t.Context()); err != nil {
+		t.Fatalf("existing cluster tried to fetch credentials: %v", err)
+	}
+	if err := cfg.RequireTransferServiceAccount(); err != nil {
+		t.Fatal(err)
+	}
+	if got := cfg.TransferServiceAccount(); got != "" {
+		t.Fatalf("S3 install inherited transfer account %q", got)
+	}
+}
+
+func TestExistingClusterScriptEnvironment(t *testing.T) {
+	cfg := Config{
+		ExistingCluster: true, ProjectID: "ambient-project",
+		ClusterName: "ambient-cluster", ClusterLocation: "ambient-location",
+		shellEnv: map[string]string{
+			"PROJECT_ID": "ambient-project", "ATE_INSTALL_KIND": "true",
+			"MEMORYSTORE_INSTANCE": "ambient-instance",
+			"SNAPSHOT_TRANSFER_GSA_NAME": "ambient-account",
+		},
+	}
+	env := scriptEnvMap(t, &cfg)
+	if env["ATE_EXISTING_CLUSTER"] != "true" || env["NO_DEV_ENV"] != "true" {
+		t.Fatalf("helper did not receive the existing-cluster profile: %v", env)
+	}
+	for _, name := range []string{"PROJECT_ID", "CLUSTER_NAME", "CLUSTER_LOCATION", "MEMORYSTORE_INSTANCE", "SNAPSHOT_TRANSFER_GSA_NAME", "ATE_INSTALL_KIND"} {
+		if _, present := env[name]; present {
+			t.Errorf("helper inherited %s=%q", name, env[name])
+		}
+	}
+}
+
+func TestSourceRootOutsideCheckout(t *testing.T) {
+	loadEnv(t)
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "go.mod"), []byte("module example.test/resources\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(SourceRootEnv, root)
+	outside := t.TempDir()
+	t.Chdir(outside)
+	if err := os.WriteFile("install.yaml", []byte(validHeader+"existingCluster:\n  enabled: true\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := LoadFlags(optionsFlagSetForTest(t), LoadOptions{ConfigPath: "install.yaml"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.Root != root || !cfg.ExistingCluster {
+		t.Fatalf("Root=%q ExistingCluster=%v", cfg.Root, cfg.ExistingCluster)
+	}
+	cwd, err := os.Getwd()
+	if err != nil || cwd != outside {
+		t.Fatalf("working directory changed: %q, %v", cwd, err)
+	}
+}
+
+func TestSourceRootRejectsInvalidOverrides(t *testing.T) {
+	for _, root := range []string{"relative", t.TempDir()} {
+		t.Run(root, func(t *testing.T) {
+			t.Setenv(SourceRootEnv, root)
+			if _, err := RepoRoot(); err == nil || !strings.Contains(err.Error(), SourceRootEnv) {
+				t.Fatalf("error=%v, want explicit source-root error", err)
+			}
+		})
+	}
+}
