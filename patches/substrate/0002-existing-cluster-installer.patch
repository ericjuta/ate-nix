+# Copyright 2026 Google LLC
+# SPDX-License-Identifier: Apache-2.0
+
+apiVersion: kustomize.config.k8s.io/v1alpha1
+kind: Component
+
+# Keep the upstream nonlocal pod shape, replacing only the GKE-specific
+# credential-provider mounts and GCS storage selection. Credentials are read
+# from an operator-created Secret, never supplied as installer flags.
+patches:
+  - target:
+      group: apps
+      version: v1
+      kind: DaemonSet
+      name: atelet
+    patch: |-
+      apiVersion: apps/v1
+      kind: DaemonSet
+      metadata:
+        name: atelet
+        namespace: ate-system
+      spec:
+        template:
+          spec:
+            containers:
+            - name: atelet
+              # Retain generic certificate, drain, and storage arguments,
+              # without GKE's two node credential-provider flags.
+              args:
+              - --grpc-server-cred-bundle=/run/podidentity.podcert.ate.dev/credential-bundle.pem
+              - --client-ca-certs=/run/podidentity.podcert.ate.dev/trust-bundle.pem
+              - --ateapi-ca-file=/run/servicedns.podcert.ate.dev/trust-bundle.pem
+              - --drain-delay=0s
+              - --drain-timeout=5m
+              - --objectstore-plugin-socket=/run/objectstore-plugin/node.sock
+              volumeMounts:
+              - mountPath: /run/image-credential-provider/bin
+                $patch: delete
+              - mountPath: /run/image-credential-provider/config.yaml
+                $patch: delete
+            volumes:
+            - name: image-credential-provider-bin
+              $patch: delete
+            - name: image-credential-provider-config
+              $patch: delete
+            initContainers:
+            - name: objectstore-plugin
+              env:
+              - name: ATE_STORAGE_BACKEND
+                value: s3
+              envFrom:
+              - configMapRef:
+                  name: ate-otel-config
+              - secretRef:
+                  name: ate-snapshot-storage
+  - target:
+      group: apps
+      version: v1
+      kind: Deployment
+      name: ate-api-server
+    patch: |-
+      apiVersion: apps/v1
+      kind: Deployment
+      metadata:
+        name: ate-api-server
+        namespace: ate-system
+      spec:
+        template:
+          spec:
+            initContainers:
+            - name: objectstore-plugin
+              env:
+              - name: ATE_STORAGE_BACKEND
+                value: s3
+              envFrom:
+              - configMapRef:
+                  name: ate-otel-config
+              - secretRef:
+                  name: ate-snapshot-storage
