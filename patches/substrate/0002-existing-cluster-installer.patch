+func TestExistingClusterOverlaySelection(t *testing.T) {
+	for _, tc := range []struct {
+		cfg  config.Config
+		want string
+	}{
+		{config.Config{}, "/base"},
+		{config.Config{Kind: true}, "/kind"},
+		{config.Config{Router: config.RouterAgentgateway}, "/agentgateway"},
+		{config.Config{Kind: true, Router: config.RouterAgentgateway}, "/kind-agentgateway"},
+		{config.Config{ExistingCluster: true}, "/existing-cluster"},
+		{config.Config{ExistingCluster: true, Router: config.RouterAgentgateway}, "/existing-cluster-agentgateway"},
+	} {
+		if got := SystemOverlay(&tc.cfg); got != installDir+tc.want {
+			t.Errorf("SystemOverlay(%+v)=%q, want %q", tc.cfg, got, installDir+tc.want)
+		}
+	}
+}
+
+func TestExistingClusterPrebuiltManifests(t *testing.T) {
+	root := repoRoot(t)
+	// A supplied digest is used verbatim by the real prebuilt resolver. No
+	// registry, Go, ko, Docker, kubectl, or external kustomize is needed here.
+	t.Setenv("PATH", t.TempDir())
+	for _, router := range []string{config.RouterEnvoy, config.RouterAgentgateway} {
+		t.Run(router, func(t *testing.T) {
+			e := &Env{Cfg: &config.Config{
+				Root: root, ExistingCluster: true, Router: router,
+				Images: images.Source{Repo: "registry.example.com/substrate", Tag: "v1@sha256:" + strings.Repeat("a", 64)},
+				IngressAllowedSPIFFEIDs: []string{"spiffe://cluster.local/ns/ate-system/sa/ate-client"},
+			}}
+			full, err := e.renderSystemManifests(t.Context())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(full), "ko://") {
+				t.Fatal("unresolved build references remain in prebuilt manifests")
+			}
+			assertExistingClusterManifest(t, full, 2)
+			for _, path := range []string{e.apiServerManifestPath(), e.ateletManifestPath()} {
+				manifest, err := e.renderResolve(t.Context(), path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				assertExistingClusterManifest(t, manifest, 1)
+			}
+			routerManifest, err := e.renderAtenetRouterManifest(t.Context())
+			if err != nil {
+				t.Fatal(err)
+			}
+			assertExistingClusterManifest(t, routerManifest, 0)
+			if got := e.otelConfigPath(); got != e.Cfg.Manifest("existing-cluster", "ate-otel-config.yaml") {
+				t.Errorf("targeted redeploy uses %q", got)
+			}
+		})
+	}
+}
+
+func assertExistingClusterManifest(t *testing.T, manifest []byte, wantPlugins int) {
+	t.Helper()
+	for _, forbidden := range []string{"kind-registry:", "http://rustfs.", "gke-managed-otel", "rustfsadmin", "AGENTGATEWAY_OTLP_ADDRESS"} {
+		if strings.Contains(string(manifest), forbidden) {
+			t.Errorf("portable manifest contains %q", forbidden)
+		}
+	}
+	objects, err := kube.DecodeManifestBytes(manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plugins := 0
+	for _, object := range objects {
+		if object.GetKind() == "ServiceMonitor" || object.GetName() == "rustfs" || object.GetName() == "prometheus" || object.GetName() == "jaeger" {
+			t.Errorf("unexpected development/monitoring resource %s", kube.Describe(object))
+		}
+		pod, found, err := unstructured.NestedMap(object.Object, "spec", "template", "spec")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !found {
+			continue
+		}
+		var spec corev1.PodSpec
+		if err := runtime.DefaultUnstructuredConverter.FromUnstructured(pod, &spec); err != nil {
+			t.Fatal(err)
+		}
+		for _, volume := range spec.Volumes {
+			if strings.HasPrefix(volume.Name, "image-credential-provider-") {
+				t.Errorf("portable atelet retained cloud node volume %q", volume.Name)
+			}
+		}
+		for _, containers := range [][]corev1.Container{spec.Containers, spec.InitContainers} {
+			for _, container := range containers {
+				hasSecret, hasTelemetry, s3 := false, false, false
+				for _, source := range container.EnvFrom {
+					if source.SecretRef != nil && source.SecretRef.Name == "ate-snapshot-storage" {
+						hasSecret = true
+					}
+					if source.ConfigMapRef != nil && source.ConfigMapRef.Name == "ate-otel-config" {
+						hasTelemetry = true
+					}
+				}
+				if container.Name == "objectstore-plugin" {
+					plugins++
+					for _, env := range container.Env {
+						if env.Name == "ATE_STORAGE_BACKEND" && env.Value == "s3" {
+							s3 = true
+						}
+					}
+					if !hasSecret || !hasTelemetry || !s3 {
+						t.Errorf("object-store sidecar lost S3/secret/shared-config: %+v", container)
+					}
+				} else if hasSecret {
+					t.Errorf("storage credentials leaked to container %q", container.Name)
+				}
+				if container.Name == "atelet" {
+					for _, arg := range container.Args {
+						if strings.HasPrefix(arg, "--image-credential-provider-") || strings.HasPrefix(arg, "--localhost-registry-replacement=") {
+							t.Errorf("portable atelet retained a cloud/local-registry argument %q", arg)
+						}
+					}
+					for _, required := range []string{
+						"--grpc-server-cred-bundle=", "--client-ca-certs=",
+						"--ateapi-ca-file=", "--objectstore-plugin-socket=",
+					} {
+						if !slices.ContainsFunc(container.Args, func(arg string) bool {
+							return strings.HasPrefix(arg, required) && len(arg) > len(required)
+						}) {
+							t.Errorf("portable atelet lacks a nonempty %s argument: %v", required, container.Args)
+						}
+					}
+					for _, mount := range container.VolumeMounts {
+						if strings.HasPrefix(mount.MountPath, "/run/image-credential-provider/") {
+							t.Errorf("portable atelet retained cloud mount %q", mount.MountPath)
+						}
+					}
+				}
+			}
+		}
+	}
+	if plugins != wantPlugins {
+		t.Errorf("patched %d object-store sidecars, want %d", plugins, wantPlugins)
+	}
+}
+
+func TestExistingClusterAgentgatewayPreservesSharedPolicies(t *testing.T) {
+	cfg := config.Config{
+		Root: repoRoot(t), ExistingCluster: true, Router: config.RouterAgentgateway,
+		Images: images.Source{Repo: "registry.example.com/substrate", Tag: "v1@sha256:" + strings.Repeat("a", 64)},
+		IngressAllowedSPIFFEIDs: []string{"spiffe://cluster.local/ns/ate-system/sa/ate-client"},
+	}
+	t.Setenv("PATH", t.TempDir())
+	portableEnv := &Env{Cfg: &cfg}
+	portable, err := portableEnv.renderAtenetRouterManifest(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertExistingClusterManifest(t, portable, 0)
+
+	baselineCfg := cfg
+	baselineCfg.ExistingCluster = false
+	baselineEnv := &Env{Cfg: &baselineCfg}
+	baseline, err := baselineEnv.renderAtenetRouterManifest(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got, want map[string]any
+	if err := yaml.Unmarshal([]byte(agentgatewayRouterConfig(t, portable).Data["config.yaml"]), &got); err != nil {
+		t.Fatal(err)
+	}
+	if err := yaml.Unmarshal([]byte(agentgatewayRouterConfig(t, baseline).Data["config.yaml"]), &want); err != nil {
+		t.Fatal(err)
+	}
+	policies, ok := want["frontendPolicies"].(map[string]any)
+	if !ok || policies["tracing"] == nil {
+		t.Fatal("shared gateway config no longer has its optional tracing policy")
+	}
+	delete(policies, "tracing")
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("portable gateway changed more than its optional tracing policy:\ngot: %+v\nwant: %+v", got, want)
+	}
+}
