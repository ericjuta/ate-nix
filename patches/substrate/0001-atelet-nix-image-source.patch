+// ensureImage makes the image behind ref available on the node and returns
+// it, the digest the cache GC roots it by, and its layers as the worker pods
+// see them. A "nix:" ref is a Nix store path,
+// served by nixImages as a closure view; it has no digest, and its view is
+// rooted by layer path alone. Any other ref is an OCI image.
+func ensureImage(ctx context.Context, imageCache *imagecache.Store, nixImages *niximage.Store, ref string) (*imagecache.Image, string, []string, error) {
+	storePath, isNix, err := nixref.Parse(ref)
+	if err != nil {
+		return nil, "", nil, err
+	}
+	if isNix {
+		if nixImages == nil {
+			return nil, "", nil, fmt.Errorf("image %q is a nix store path, but nix images are not enabled on this node (--nix-view-dir)", ref)
+		}
+		img, layers, err := nixImages.EnsureImage(ctx, storePath)
+		if err != nil {
+			return nil, "", nil, fmt.Errorf("in nixImages.EnsureImage(%q): %w", storePath, err)
+		}
+		return img, "", layers, nil
+	}
+	img, err := imageCache.EnsureImage(ctx, ref)
+	if err != nil {
+		return nil, "", nil, fmt.Errorf("in imageCache.EnsureImage(%q): %w", ref, err)
+	}
+	return img, img.Digest.String(), img.LayerDirs, nil
+}
