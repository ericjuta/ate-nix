+// limitations under the License.
+
+package niximage
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// The stderr below is what nix-store --realise printed against a Nix 2.35.6
+// daemon with require-sigs set, for each way the daemon refuses a path.
+
+const envHash = "0c0zb1l7mqvdrsgjq7b9vl0g9cyfh3q1"
+
+func missingStderr(extra string) string {
+	return extra + "don't know how to build these paths:\n" +
+		"  " + envPath + "\n" +
+		"error: path '" + envPath + "' is required, but there is no substituter that can build it\n"
+}
+
+func refusedStderr(caches ...string) string {
+	s := "this path will be fetched (0.1 KiB download, 0.1 KiB unpacked):\n  " + envPath + "\n"
+	for _, c := range caches {
+		s += "warning: ignoring substitute for '" + envPath + "' from '" + c + "', as it's not signed by any of the keys in 'trusted-public-keys'\n"
+	}
+	return s + "error: path '" + envPath + "' is required, but there is no substituter that can build it\n"
+}
+
+func narinfo(storePath string, sigs ...string) string {
+	s := "StorePath: " + storePath + "\nURL: nar/x.nar.xz\nCompression: xz\nNarSize: 136\nReferences: \n"
+	for _, sig := range sigs {
+		s += "Sig: " + sig + ":Z55j+WBReafjPltdpMZqD9L29Ax7u+uEUpXMAs5ZjbOEL9bPzyPVuGmkhewwwx2XxtNi11RNUTpOZiooQAp8Bg==\n"
+	}
+	return s
+}
+
+// binaryCache serves narinfo files by name, like an HTTP binary cache.
+func binaryCache(t *testing.T, files map[string]string) string {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, ok := files[strings.TrimPrefix(r.URL.Path, "/")]
+		if !ok {
+			http.NotFound(w, r)
+			return
+		}
+		_, _ = io.WriteString(w, body)
+	}))
+	t.Cleanup(srv.Close)
+	return srv.URL
+}
+
+// realiseError builds a view whose realise fails with stderr and returns
+// the error, plus the message nix-store's own error carries.
+func realiseError(t *testing.T, stderr string) (got, nixErr string) {
+	t.Helper()
+	node, viewDir := newFakeNode(t)
+	node.realiseStderr = stderr
+	s := newStore(t, node, viewDir)
+	_, _, err := s.EnsureImage(t.Context(), envPath)
+	if err == nil {
+		t.Fatal("EnsureImage succeeded, want a realise error")
+	}
+	gcRoot := filepath.Join(viewDir, gcRootsDirName, envBase)
+	return err.Error(), fmt.Sprintf("nix-store --realise %s --add-root %s: exit status 1: %s", envPath, gcRoot, redactURLs(strings.TrimSpace(stderr)))
+}
+
+func TestRealiseFailureSaysWhy(t *testing.T) {
+	unsigned := binaryCache(t, map[string]string{envHash + ".narinfo": narinfo(envPath)})
+	rogue := binaryCache(t, map[string]string{envHash + ".narinfo": narinfo(envPath, "ate-rogue-1", "other-2", "ate-rogue-1")})
+	const unreachable = "warning: unable to download 'http://cache.invalid/nix-cache-info': Could not resolve hostname (6) Could not resolve host: cache.invalid\n"
+	tests := []struct {
+		name, stderr, want string
+	}{
+		{
+			"no cache has the path",
+			missingStderr(""),
+			"no binary cache configured on this node has " + envPath,
+		},
+		{
+			"no reachable cache has the path",
+			missingStderr(unreachable),
+			"no binary cache this node could reach has " + envPath,
+		},
+		{
+			"a cache has it unsigned",
+			refusedStderr(unsigned),
+			"binary cache " + unsigned + " has " + envPath + ", but it carries no signature (the node takes only paths signed by a key in its trusted-public-keys)",
+		},
+		{
+			"a cache has it signed by keys the node does not trust",
+			refusedStderr(rogue),
+			"binary cache " + rogue + " has " + envPath + ", signed only by keys this node does not trust: ate-rogue-1, other-2 (the node takes only paths signed by a key in its trusted-public-keys)",
+		},
+		{
+			"two caches, two reasons",
+			refusedStderr(unsigned, rogue),
+			"binary cache " + unsigned + " has " + envPath + ", but it carries no signature; binary cache " + rogue + " has " + envPath + ", signed only by keys this node does not trust: ate-rogue-1, other-2 (",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, nixErr := realiseError(t, tc.stderr)
+			if !strings.HasPrefix(got, fmt.Sprintf("while realising %q: %s", envPath, tc.want)) {
+				t.Errorf("error = %q\nwant it to start with the reason %q", got, tc.want)
+			}
+			// Nix's own report still follows the reason.
+			if !strings.HasSuffix(got, "; "+nixErr) {
+				t.Errorf("error = %q\nwant it to end with nix-store's error %q", got, nixErr)
+			}
+		})
+	}
+
+	got, _ := realiseError(t, missingStderr(""))
+	for _, word := range []string{"sign", "trust"} {
+		if strings.Contains(got, word) {
+			t.Errorf("a missing path's error mentions %q: %q", word, got)
+		}
+	}
+}
+
+func TestRealiseFailureFallsBackToNixError(t *testing.T) {
+	gone := binaryCache(t, nil)
+	tests := []struct {
+		name   string
+		stderr func(t *testing.T) string
+	}{
+		{"not a substitution failure", func(*testing.T) string {
+			return "error: cannot connect to socket at '/nix/var/nix/daemon-socket/socket': Connection refused\n"
+		}},
+		{"the cache no longer has the narinfo", func(*testing.T) string { return refusedStderr(gone) }},
+		{"the narinfo is for another path", func(t *testing.T) string {
+			return refusedStderr(binaryCache(t, map[string]string{envHash + ".narinfo": narinfo(LogicalStoreDir+"/"+otherBase, "k-1")}))
+		}},
+		{"a signature with a malformed key name", func(t *testing.T) string {
+			return refusedStderr(binaryCache(t, map[string]string{envHash + ".narinfo": narinfo(envPath, "evil key\x1b[31m")}))
+		}},
+		{"a cache that is not http", func(*testing.T) string { return refusedStderr("file:///cache") }},
+		{"a narinfo larger than the cap", func(t *testing.T) string {
+			big := narinfo(envPath) + strings.Repeat("X-Padding: y\n", maxNarinfoSize/13+1)
+			return refusedStderr(binaryCache(t, map[string]string{envHash + ".narinfo": big}))
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, nixErr := realiseError(t, tc.stderr(t))
+			if want := fmt.Sprintf("while realising %q: %s", envPath, nixErr); got != want {
+				t.Errorf("error = %q\nwant nix-store's own error %q", got, want)
+			}
+		})
+	}
+}
+
+func TestRealiseFailureRedactsCredentials(t *testing.T) {
+	rogue := binaryCache(t, map[string]string{envHash + ".narinfo": narinfo(envPath, "ate-rogue-1")})
+	withSecrets := strings.Replace(rogue, "http://", "http://probe:s3cret@", 1) + "/?token=abc"
+	tests := []struct {
+		name, stderr, want string
+	}{
+		{"diagnosed", refusedStderr(withSecrets), "signed only by keys this node does not trust: ate-rogue-1"},
+		{"fallback", refusedStderr("http://probe:s3cret@cache.invalid/?token=abc"), "exit status 1: this path will be fetched"},
+		{"bare token userinfo", missingStderr("warning: unable to download 'https://t0k3n@cache.invalid/nix-cache-info?token=abc': HTTP error 401\n"), "no binary cache this node could reach has"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, _ := realiseError(t, tc.stderr)
+			if !strings.Contains(got, tc.want) {
+				t.Errorf("error = %q, want it to contain %q", got, tc.want)
+			}
+			for _, secret := range []string{"s3cret", "t0k3n", "abc", "probe"} {
+				if strings.Contains(got, secret) {
+					t.Errorf("error leaks %q: %q", secret, got)
+				}
+			}
+			if !strings.Contains(got, "[redacted]@") {
+				t.Errorf("error = %q, want the cache's userinfo shown as redacted", got)
+			}
+		})
+	}
+}
+
+func TestRedactURL(t *testing.T) {
+	for in, want := range map[string]string{
+		"http://ate-nix-cache":                         "http://ate-nix-cache",
+		"https://u:p@cache.example.com:8443/sub/":      "https://[redacted]@cache.example.com:8443/sub/",
+		"s3://bucket?region=eu-west-1&secret-key=/k":   "s3://bucket?[redacted]",
+		"file:///cache":                                "file:///cache",
+		"https://tok@h/a@b":                            "https://[redacted]@h/a@b",
+		"http://[::1]:8080/x#frag":                     "http://[::1]:8080/x?[redacted]",
+		"https://cache.nixos.org/abc.narinfo?x=1#frag": "https://cache.nixos.org/abc.narinfo?[redacted]",
+	} {
+		if got := redactURL(in); got != want {
+			t.Errorf("redactURL(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
