+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package niximage is the Nix image source: it turns a Nix store path into
+// something an actor can run, with no OCI image and no registry.
+//
+// A container whose image is "nix:/nix/store/<hash>-<name>" names the root of
+// a closure that was built and signed ahead of time. Nothing is evaluated or
+// built here. The node's Nix daemon substitutes whichever of the closure's
+// paths it is missing from its configured binary caches, under its own
+// signature policy, and this package then exposes exactly that closure to the
+// actor as one read-only directory ("view"):
+//
+//	<viewDir>/views/<hash>-<name>/fs/nix/store/<path>/...   hard links
+//	<viewDir>/views/<hash>-<name>/fs/{bin,etc,...}          links into the root path
+//
+// The view is handed to the worker as a single overlay lowerdir, through the
+// same rootfs-overlay.json contract OCI images use (see imagecache.OverlaySpec),
+// so the worker runtimes need no change. An actor sees only its own closure,
+// never the rest of the node's store.
+//
+// Files are hard links, so every view of a store path shares that path's
+// blocks and page cache, and a view stays intact even if the Nix garbage
+// collector later deletes the store path. Hard links cannot cross mounts:
+// viewDir must be on the same mount as the store, as atelet sees them.
+package niximage
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	v1 "github.com/google/go-containerregistry/pkg/v1"
+	"go.ate.dev/substrate/internal/imagecache"
+	"go.ate.dev/substrate/internal/nixref"
+	"golang.org/x/sync/singleflight"
+)
+
+const (
+	// LogicalStoreDir is where the closure appears inside the actor.
+	LogicalStoreDir = nixref.StoreDir
+
+	// ConfigFileName is the optional file in the closure's root path that
+	// plays the role of the OCI image config (Entrypoint, Cmd, Env,
+	// WorkingDir, User), in the same JSON shape.
+	ConfigFileName = "ate-image-config.json"
+
+	// layerFSDirName is the subdirectory of a layer directory that holds its
+	// tree; it must match imagecache's layer layout.
+	layerFSDirName = "fs"
+
+	maxConfigSize   = 1 << 20
+	maxSymlinkHops  = 40
+	defaultMinAge   = 2 * time.Minute
+	viewsDirName    = "views"
+	gcRootsDirName  = "gcroots"
+	tmpDirName      = "tmp"
+	defaultNixStore = "nix-store"
+)
+
+// Runner runs the nix-store command with args and returns its standard output.
+type Runner func(ctx context.Context, args ...string) ([]byte, error)
+
+// Store builds and caches closure views.
+type Store struct {
+	viewDir  string
+	mountDir string
+	storeDir string
+	run      Runner
+	minAge   time.Duration
+
+	sf singleflight.Group
+
+	// mu closes the hit-versus-evict window: a cache hit holds it shared
+	// while it checks and touches a view, eviction holds it exclusively
+	// while it re-checks and removes one.
+	mu sync.RWMutex
+}
+
+// Option configures a Store.
+type Option func(*Store)
+
+// WithMountDir sets the directory under which the worker pods see viewDir,
+// when that differs from where atelet builds the views (for example when the
+// node bind-mounts the view directory under the shared ate base path). Layer
+// paths handed to the workers are rooted here.
+func WithMountDir(dir string) Option {
+	return func(s *Store) {
+		if dir != "" {
+			s.mountDir = dir
+		}
+	}
+}
+
+// WithStoreDir overrides where atelet reads store paths from (default
+// /nix/store). The closure always appears at /nix/store inside the actor.
+func WithStoreDir(dir string) Option {
+	return func(s *Store) { s.storeDir = dir }
+}
+
+// WithNixStoreCommand sets the nix-store executable (default "nix-store",
+// resolved on PATH). It is run with NIX_REMOTE=daemon.
+func WithNixStoreCommand(command string) Option {
+	return func(s *Store) {
+		if command != "" {
+			s.run = commandRunner(command)
+		}
+	}
+}
+
+// WithRunner replaces how nix-store is invoked.
+func WithRunner(r Runner) Option {
+	return func(s *Store) { s.run = r }
+}
+
+// WithMinAge sets how long an unreferenced view is kept before EvictUnused
+// may remove it (default 2m), covering the window between EnsureImage and
+// the bundle spec write that roots the view.
+func WithMinAge(d time.Duration) Option {
+	return func(s *Store) { s.minAge = d }
+}
+
+func commandRunner(command string) Runner {
+	return func(ctx context.Context, args ...string) ([]byte, error) {
+		cmd := exec.CommandContext(ctx, command, args...)
+		// Always go through the daemon: it owns the store, the substituter
+		// list, and the signature policy. atelet must not write the store.
+		cmd.Env = append(os.Environ(), "NIX_REMOTE=daemon")
+		var stderr bytes.Buffer
+		cmd.Stderr = &stderr
+		out, err := cmd.Output()
+		if err != nil {
+			return nil, &commandError{command: command, args: args, err: err, stderr: stderr.String()}
+		}
+		return out, nil
+	}
+}
+
+// New opens (creating if needed) the view store rooted at viewDir and removes
+// views left half-built by a previous process.
+func New(viewDir string, opts ...Option) (*Store, error) {
+	s := &Store{
+		viewDir:  viewDir,
+		mountDir: viewDir,
+		storeDir: LogicalStoreDir,
+		run:      commandRunner(defaultNixStore),
+		minAge:   defaultMinAge,
+	}
+	for _, o := range opts {
+		o(s)
+	}
+	if err := removeAll(filepath.Join(viewDir, tmpDirName)); err != nil {
+		return nil, fmt.Errorf("while clearing unfinished nix views: %w", err)
+	}
+	for _, d := range []string{viewsDirName, gcRootsDirName, tmpDirName} {
+		if err := os.MkdirAll(filepath.Join(viewDir, d), 0o755); err != nil {
+			return nil, fmt.Errorf("while creating nix view dir: %w", err)
+		}
+	}
+	return s, nil
+}
+
+// EnsureImage makes the closure of storePath available on this node and
+// returns it as an image with a single layer. The returned image has no
+// digest: the store path is its identity. The image's LayerDirs are this
+// process's paths, for reading files out of it; the second result is the same
+// layers as the worker pods see them, for the overlay spec.
+func (s *Store) EnsureImage(ctx context.Context, storePath string) (*imagecache.Image, []string, error) {
+	if !nixref.IsStorePath(storePath) {
+		return nil, nil, fmt.Errorf("invalid nix store path %q", storePath)
+	}
+	if nixref.IsDerivation(storePath) {
+		return nil, nil, fmt.Errorf("nix store path %q is a derivation, not a built path", storePath)
+	}
+	base := path.Base(storePath)
+
+	if !s.hit(base) {
+		_, err, _ := s.sf.Do(base, func() (any, error) {
+			if s.hit(base) {
+				return nil, nil
+			}
+			// Detached from the caller: other callers may be waiting on the
+			// same build, and a view is useful to the next actor regardless.
+			return nil, s.build(context.WithoutCancel(ctx), storePath)
+		})
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+
+	cfg, err := readConfig(filepath.Join(s.viewDir, viewsDirName, base, layerFSDirName), base)
+	if err != nil {
+		return nil, nil, fmt.Errorf("nix image %q: %w", storePath, err)
+	}
+	return &imagecache.Image{
+		Config:    cfg,
+		LayerDirs: []string{filepath.Join(s.viewDir, viewsDirName, base)},
+	}, []string{filepath.Join(s.mountDir, viewsDirName, base)}, nil
+}
+
+// hit reports whether the view exists, marking it used.
+func (s *Store) hit(base string) bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	view := filepath.Join(s.viewDir, viewsDirName, base)
+	if _, err := os.Stat(filepath.Join(view, layerFSDirName)); err != nil {
+		return false
+	}
+	now := time.Now()
+	_ = os.Chtimes(view, now, now)
+	return true
+}
+
+func (s *Store) build(ctx context.Context, storePath string) (err error) {
+	base := path.Base(storePath)
+
+	// Realise first, registering a GC root in the same step so the closure
+	// cannot be collected between substitution and linking. The root lives
+	// as long as the view does.
+	gcRoot := filepath.Join(s.viewDir, gcRootsDirName, base)
+	defer func() {
+		// Without a view nothing would ever evict the root, and the closure
+		// would stay pinned in the store for good.
+		if err != nil {
+			_ = os.Remove(gcRoot)
+		}
+	}()
+	if _, err := s.run(ctx, "--realise", storePath, "--add-root", gcRoot); err != nil {
+		var cmdErr *commandError
+		if errors.As(err, &cmdErr) {
+			if why := explainRealiseFailure(ctx, cmdErr.stderr); why != "" {
+				return fmt.Errorf("while realising %q: %s; %w", storePath, why, err)
+			}
+		}
+		return fmt.Errorf("while realising %q: %w", storePath, err)
+	}
+	out, err := s.run(ctx, "--query", "--requisites", storePath)
+	if err != nil {
+		return fmt.Errorf("while querying the closure of %q: %w", storePath, err)
+	}
+	closure := strings.Fields(string(out))
+	hasRoot := false
+	for _, p := range closure {
+		// The daemon's answer is trusted for content, not for shape: every
+		// path is joined below, so each must be a plain store path.
+		if !nixref.IsStorePath(p) {
+			return fmt.Errorf("closure of %q lists %q, which is not a store path", storePath, p)
+		}
+		hasRoot = hasRoot || p == storePath
+	}
+	if !hasRoot {
+		return fmt.Errorf("closure of %q does not include the path itself", storePath)
+	}
+
+	tmp, err := os.MkdirTemp(filepath.Join(s.viewDir, tmpDirName), base+"-*")
+	if err != nil {
+		return fmt.Errorf("while creating view temp dir: %w", err)
+	}
+	defer removeAll(tmp) // no-op once the rename succeeds
+	if err := os.Chmod(tmp, 0o755); err != nil {
+		return err
+	}
+	fsDir := filepath.Join(tmp, layerFSDirName)
+	if err := os.MkdirAll(filepath.Join(fsDir, LogicalStoreDir), 0o755); err != nil {
+		return err
+	}
+	for _, p := range closure {
+		name := path.Base(p)
+		if err := linkTree(filepath.Join(s.storeDir, name), filepath.Join(fsDir, LogicalStoreDir, name)); err != nil {
+			return fmt.Errorf("while linking %q into the view: %w", p, err)
+		}
+	}
+	if err := populateRoot(fsDir, base); err != nil {
+		return fmt.Errorf("while laying out the root of %q: %w", storePath, err)
+	}
+
+	final := filepath.Join(s.viewDir, viewsDirName, base)
+	if err := os.Rename(tmp, final); err != nil {
+		return fmt.Errorf("while moving view into place: %w", err)
+	}
+	return nil
+}
+
+// linkTree reproduces the tree at src under dst: directories are created,
+// regular files hard-linked, symlinks copied. Anything else is an error; a
+// store path holds nothing else.
+func linkTree(src, dst string) error {
+	return filepath.WalkDir(src, func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(src, p)
+		if err != nil {
+			return err
+		}
+		target := filepath.Join(dst, rel)
+		switch {
+		case d.IsDir():
+			// Writable by the owner so the view can be removed again; the
+			// actor sees it through a read-only lowerdir either way.
+			return os.Mkdir(target, 0o755)
+		case d.Type()&fs.ModeSymlink != 0:
+			link, err := os.Readlink(p)
+			if err != nil {
+				return err
+			}
+			return os.Symlink(link, target)
+		case d.Type().IsRegular():
+			if err := os.Link(p, target); err != nil {
+				if errors.Is(err, syscall.EXDEV) {
+					return fmt.Errorf("%w (the nix view dir must be on the same mount as the nix store)", err)
+				}
+				return err
+			}
+			return nil
+		default:
+			return fmt.Errorf("%q is neither a directory, a regular file, nor a symlink", p)
+		}
+	})
+}
+
+// populateRoot gives the view a conventional root from the closure's root
+// path: each top-level directory of the root path becomes a real directory
+// whose entries link into the store, so /bin/sh, /etc/passwd and the like
+// resolve, and the worker can still add its own files (resolv.conf, bind
+// targets) beside them. The mount points every sandbox expects are created
+// too.
+func populateRoot(fsDir, rootBase string) error {
+	rootRel := path.Join(LogicalStoreDir, rootBase)
+	_, rootInfo, err := resolveInTree(fsDir, rootRel)
+	if err != nil {
+		return err
+	}
+	if rootInfo.IsDir() {
+		rootDir := filepath.Join(fsDir, rootRel)
+		entries, err := os.ReadDir(rootDir)
+		if err != nil {
+			return err
+		}
+		for _, e := range entries {
+			name := e.Name()
+			if name == "nix" || name == ConfigFileName {
+				continue
+			}
+			_, info, err := resolveInTree(fsDir, path.Join(rootRel, name))
+			if err != nil {
+				if errors.Is(err, fs.ErrNotExist) {
+					continue // dangling link in the root path
+				}
+				return err
+			}
+			if !info.IsDir() {
+				if err := os.Symlink(path.Join(rootRel, name), filepath.Join(fsDir, name)); err != nil {
+					return err
+				}
+				continue
+			}
+			if err := os.Mkdir(filepath.Join(fsDir, name), 0o755); err != nil {
+				return err
+			}
+			childDir, _, err := resolveInTree(fsDir, path.Join(rootRel, name))
+			if err != nil {
+				return err
+			}
+			children, err := os.ReadDir(childDir)
+			if err != nil {
+				return err
+			}
+			for _, c := range children {
+				if err := os.Symlink(path.Join(rootRel, name, c.Name()), filepath.Join(fsDir, name, c.Name())); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	for _, d := range []struct {
+		name string
+		mode fs.FileMode
+	}{{"proc", 0o555}, {"sys", 0o555}, {"dev", 0o755}, {"etc", 0o755}, {"tmp", 0o777 | fs.ModeSticky}} {
+		p := filepath.Join(fsDir, d.name)
+		if err := os.Mkdir(p, 0o755); err != nil {
+			if errors.Is(err, fs.ErrExist) {
+				continue
+			}
+			return err
+		}
+		if err := os.Chmod(p, d.mode); err != nil {
+			return err
+		}
+	}
+	// atelet resolves the image user from these two files without following
+	// links out of the layer, so they must be real files in the view.
+	for _, name := range []string{"etc/passwd", "etc/group"} {
+		src, info, err := resolveInTree(fsDir, name)
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		dst := filepath.Join(fsDir, name)
+		if src == dst {
+			continue
+		}
+		if err := os.Remove(dst); err != nil {
+			return err
+		}
+		if err := os.Link(src, dst); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// resolveInTree resolves name inside root the way a process chrooted there
+// would: absolute symlink targets restart at root, and ".." never climbs
+// above it. It returns the host path of the final, non-symlink entry.
+func resolveInTree(root, name string) (string, fs.FileInfo, error) {
+	remaining := strings.Split(name, "/")
+	var resolved []string
+	hops := 0
+	for len(remaining) > 0 {
+		c := remaining[0]
+		remaining = remaining[1:]
+		switch c {
+		case "", ".":
+			continue
+		case "..":
+			if len(resolved) > 0 {
+				resolved = resolved[:len(resolved)-1]
+			}
+			continue
+		}
+		p := filepath.Join(root, filepath.Join(resolved...), c)
+		info, err := os.Lstat(p)
+		if err != nil {
+			return "", nil, err
+		}
+		if info.Mode()&fs.ModeSymlink != 0 {
+			if hops++; hops > maxSymlinkHops {
+				return "", nil, &fs.PathError{Op: "resolve", Path: name, Err: syscall.ELOOP}
+			}
+			target, err := os.Readlink(p)
+			if err != nil {
+				return "", nil, err
+			}
+			if strings.HasPrefix(target, "/") {
+				resolved = nil
+			}
+			remaining = append(strings.Split(target, "/"), remaining...)
+			continue
+		}
+		if len(remaining) > 0 && !info.IsDir() {
+			return "", nil, &fs.PathError{Op: "resolve", Path: name, Err: syscall.ENOTDIR}
+		}
+		resolved = append(resolved, c)
+	}
+	p := filepath.Join(root, filepath.Join(resolved...))
+	info, err := os.Lstat(p)
+	if err != nil {
+		return "", nil, err
+	}
+	return p, info, nil
+}
+
+// readConfig reads the optional image config from the closure's root path.
+func readConfig(fsDir, rootBase string) (v1.Config, error) {
+	var cfg v1.Config
+	p, info, err := resolveInTree(fsDir, path.Join(LogicalStoreDir, rootBase, ConfigFileName))
+	if errors.Is(err, fs.ErrNotExist) || errors.Is(err, syscall.ENOTDIR) {
+		return cfg, nil
+	}
+	if err != nil {
+		return cfg, fmt.Errorf("while resolving %s: %w", ConfigFileName, err)
+	}
+	if !info.Mode().IsRegular() {
+		return cfg, fmt.Errorf("%s is not a regular file", ConfigFileName)
+	}
+	f, err := os.Open(p)
+	if err != nil {
+		return cfg, err
+	}
+	defer f.Close()
+	b, err := io.ReadAll(io.LimitReader(f, maxConfigSize+1))
+	if err != nil {
+		return cfg, err
+	}
+	if len(b) > maxConfigSize {
+		return cfg, fmt.Errorf("%s exceeds %d bytes", ConfigFileName, maxConfigSize)
+	}
+	if err := json.Unmarshal(b, &cfg); err != nil {
+		return cfg, fmt.Errorf("while decoding %s: %w", ConfigFileName, err)
+	}
+	return cfg, nil
+}
+
+// EvictUnused removes every view that no bundle uses and that has not been
+// used for the minimum age, together with its GC root. inUse holds the base
+// names of the layer directories referenced by bundle overlay specs (see
+// imagecache.RootSet.LayerHexes). It returns the number of views removed.
+func (s *Store) EvictUnused(inUse map[string]bool) (int, error) {
+	viewsDir := filepath.Join(s.viewDir, viewsDirName)
+	entries, err := os.ReadDir(viewsDir)
+	if err != nil {
+		return 0, fmt.Errorf("while listing nix views: %w", err)
+	}
+	var (
+		removed int
+		errs    []error
+	)
+	for _, e := range entries {
+		base := e.Name()
+		if inUse[base] {
+			continue
+		}
+		trash, err := s.retire(base)
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		if trash == "" {
+			continue
+		}
+		if err := removeAll(trash); err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		removed++
+	}
+	return removed, errors.Join(errs...)
+}
+
+// retire moves an old-enough view out of the way and drops its GC root. It
+// returns the directory to delete, or "" if the view is too young.
+func (s *Store) retire(base string) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	view := filepath.Join(s.viewDir, viewsDirName, base)
+	info, err := os.Stat(view)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return "", nil
+		}
+		return "", err
+	}
+	if time.Since(info.ModTime()) < s.minAge {
+		return "", nil
+	}
+	trash, err := os.MkdirTemp(filepath.Join(s.viewDir, tmpDirName), "evict-*")
+	if err != nil {
+		return "", err
+	}
+	if err := os.Rename(view, filepath.Join(trash, base)); err != nil {
+		_ = os.Remove(trash)
+		return "", err
+	}
+	if err := os.Remove(filepath.Join(s.viewDir, gcRootsDirName, base)); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return trash, err
+	}
+	return trash, nil
+}
+
+// removeAll deletes dir, restoring write permission on directories first so
+// modes set inside a view cannot block the removal.
+func removeAll(dir string) error {
+	err := filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() {
+			return os.Chmod(p, 0o700)
+		}
+		return nil
+	})
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	return os.RemoveAll(dir)
+}
