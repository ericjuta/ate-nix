+package niximage
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"path"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	"go.ate.dev/substrate/internal/nixref"
+)
+
+// When the daemon will not substitute a path, nix-store ends with the same
+// error whether no cache has the path or a cache has it but the node does not
+// trust its signature. Its stderr tells the two apart: a missing path is
+// listed under "don't know how to build these paths:", a refused one gets an
+// "ignoring substitute" warning naming the cache. It does not say whether the
+// refused path was unsigned or signed by an untrusted key; only the cache's
+// narinfo for the path says that, so the diagnosis reads the Sig lines of
+// each refused path's narinfo. Lines are as printed by Nix 2.35.
+var (
+	refusedLine = regexp.MustCompile(`^warning: ignoring substitute for '(/nix/store/[^']+)' from '([^']+)', as it's not signed by any of the keys in 'trusted-public-keys'$`)
+	failedLine  = regexp.MustCompile(`^error: (?:path '/nix/store/[^']+' is required, but there is no substituter that can build it|some references of path '/nix/store/[^']+' could not be realised)$`)
+	keyName     = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$`)
+	urlInText   = regexp.MustCompile(`[A-Za-z][A-Za-z0-9+.-]*://[^\s'"<>]+`)
+)
+
+const (
+	missingHeader  = "don't know how to build these paths:"
+	unreachableTag = "warning: unable to download "
+
+	// Bounds on the diagnosis: one deadline for all narinfo reads, a size
+	// cap on each, and caps on how much of it ends up in the message.
+	diagnoseTimeout = 5 * time.Second
+	maxNarinfoSize  = 64 << 10
+	maxRefusals     = 4
+	maxMissing      = 4
+	maxSigners      = 8
+)
+
+var narinfoClient = &http.Client{Timeout: diagnoseTimeout}
+
+// commandError is a failed nix-store run. Its message carries nix-store's
+// stderr with credentials in URLs redacted (Nix prints a substituter's
+// userinfo verbatim); the raw stderr stays here for diagnosis.
+type commandError struct {
+	command string
+	args    []string
+	err     error
+	stderr  string
+}
+
+func (e *commandError) Error() string {
+	return fmt.Sprintf("%s %s: %v: %s", e.command, strings.Join(e.args, " "), e.err, redactURLs(strings.TrimSpace(e.stderr)))
+}
+
+func (e *commandError) Unwrap() error { return e.err }
+
+// redactURLs elides the userinfo and the query of every URL in s, keeping
+// scheme, host, port and path, so a message still says which cache it means.
+func redactURLs(s string) string {
+	return urlInText.ReplaceAllStringFunc(s, redactURL)
+}
+
+func redactURL(raw string) string {
+	scheme, rest, _ := strings.Cut(raw, "://")
+	end := strings.IndexAny(rest, "/?#")
+	if end < 0 {
+		end = len(rest)
+	}
+	authority, tail := rest[:end], rest[end:]
+	if at := strings.LastIndexByte(authority, '@'); at >= 0 {
+		authority = "[redacted]@" + authority[at+1:]
+	}
+	if q := strings.IndexAny(tail, "?#"); q >= 0 {
+		tail = tail[:q] + "?[redacted]"
+	}
+	return scheme + "://" + authority + tail
+}
+
+// refusal is a path a cache offered and the daemon refused for its signature.
+type refusal struct {
+	storePath, cache string
+}
+
+// explainRealiseFailure says in plain words why the daemon would not
+// substitute a closure, from a failed realise's stderr. It returns "" when
+// the stderr does not show a substitution failure it recognises or when any
+// narinfo read fails; the caller then reports nix-store's own error.
+func explainRealiseFailure(ctx context.Context, stderr string) string {
+	var (
+		refused     []refusal
+		missing     []string
+		failed      bool
+		unreachable bool
+		inMissing   bool
+	)
+	sc := bufio.NewScanner(strings.NewReader(stderr))
+	sc.Buffer(nil, 64<<10)
+	for sc.Scan() {
+		line := sc.Text()
+		if inMissing {
+			if p, ok := strings.CutPrefix(line, "  "); ok && nixref.IsStorePath(p) {
+				missing = append(missing, p)
+				continue
+			}
+			inMissing = false
+		}
+		switch {
+		case line == missingHeader:
+			inMissing = true
+		case failedLine.MatchString(line):
+			failed = true
+		case strings.HasPrefix(line, unreachableTag):
+			unreachable = true
+		default:
+			if m := refusedLine.FindStringSubmatch(line); m != nil && nixref.IsStorePath(m[1]) {
+				refused = append(refused, refusal{storePath: m[1], cache: m[2]})
+			}
+		}
+	}
+	if sc.Err() != nil || !failed || len(refused)+len(missing) == 0 {
+		return ""
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, diagnoseTimeout)
+	defer cancel()
+	var parts []string
+	for i, r := range refused {
+		if i == maxRefusals {
+			parts = append(parts, fmt.Sprintf("%d more refused paths", len(refused)-i))
+			break
+		}
+		signers, err := narinfoSigners(ctx, r.cache, r.storePath)
+		if err != nil {
+			return ""
+		}
+		cache := redactURL(r.cache)
+		if len(signers) == 0 {
+			parts = append(parts, fmt.Sprintf("binary cache %s has %s, but it carries no signature", cache, r.storePath))
+		} else {
+			parts = append(parts, fmt.Sprintf("binary cache %s has %s, signed only by keys this node does not trust: %s", cache, r.storePath, strings.Join(signers, ", ")))
+		}
+	}
+	if len(refused) > 0 {
+		parts[len(parts)-1] += " (the node takes only paths signed by a key in its trusted-public-keys)"
+	}
+	if len(missing) > 0 {
+		where := "no binary cache configured on this node has"
+		if unreachable {
+			where = "no binary cache this node could reach has"
+		}
+		list := missing
+		if len(list) > maxMissing {
+			list = append(list[:maxMissing:maxMissing], fmt.Sprintf("%d more", len(missing)-maxMissing))
+		}
+		parts = append(parts, where+" "+strings.Join(list, ", "))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// narinfoSigners reads storePath's narinfo from an http(s) binary cache and
+// returns the names of the keys that signed it, which a narinfo publishes.
+func narinfoSigners(ctx context.Context, cache, storePath string) ([]string, error) {
+	u, err := url.Parse(cache)
+	if err != nil {
+		return nil, err
+	}
+	if (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" {
+		return nil, fmt.Errorf("cannot read a narinfo from %s caches", u.Scheme)
+	}
+	hashPart, _, _ := strings.Cut(path.Base(storePath), "-")
+	// Query parameters configure Nix's store, they are not sent to the cache.
+	u.Path = strings.TrimSuffix(u.Path, "/") + "/" + hashPart + ".narinfo"
+	u.RawPath, u.RawQuery, u.Fragment = "", "", ""
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := narinfoClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("narinfo: HTTP %d", resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxNarinfoSize+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(body) > maxNarinfoSize {
+		return nil, errors.New("narinfo too large")
+	}
+
+	var signers []string
+	matched := false
+	for line := range strings.Lines(string(body)) {
+		key, value, ok := strings.Cut(strings.TrimRight(line, "\r\n"), ": ")
+		switch {
+		case !ok:
+		case key == "StorePath":
+			matched = value == storePath
+		case key == "Sig":
+			// The name is the cache's own text: show it only if it looks
+			// like a key name.
+			name, _, _ := strings.Cut(value, ":")
+			if !keyName.MatchString(name) {
+				return nil, errors.New("narinfo has a malformed signature")
+			}
+			if len(signers) < maxSigners && !slices.Contains(signers, name) {
+				signers = append(signers, name)
+			}
+		}
+	}
+	if !matched {
+		return nil, errors.New("narinfo is for another path")
+	}
+	return signers, nil
+}
diff --git a/internal/niximage/refusal_test.go b/internal/niximage/refusal_test.go
new file mode 100644
index 00000000..91c63d2e
--- /dev/null
+++ b/internal/niximage/refusal_test.go
@@ -0,0 +1,212 @@
+// Copyright 2026 The Agent Substrate Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
