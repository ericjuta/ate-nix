 }
 
-// ValidatePinnedImage requires a well-formed OCI image reference pinned by
-// digest (e.g. "name@sha256:..."): changing the image content under a fixed
-// reference invalidates snapshots. It parses with the same grammar the
-// container runtimes use, so a malformed digest is rejected rather than
-// treated as pinned.
+// ValidatePinnedImage requires an image reference whose content cannot change
+// under it, since that would invalidate snapshots. Two forms qualify:
+//
+//   - a well-formed OCI image reference pinned by digest (e.g.
+//     "name@sha256:..."), parsed with the same grammar the container runtimes
+//     use, so a malformed digest is rejected rather than treated as pinned;
+//   - a Nix store path, "nix:/nix/store/<hash>-<name>", whose hash names its
+//     content.
 func ValidatePinnedImage(fldPath *field.Path, value string) field.ErrorList {
 	if value == "" {
 		return nil
 	}
+	if _, isNix, err := nixref.Parse(value); isNix {
+		if err != nil {
+			return field.ErrorList{field.Invalid(fldPath, value, fmt.Sprintf("must be a well-formed nix store path: %v", err))}
+		}
+		return nil
+	}
 	ref, err := reference.ParseNormalizedNamed(value)
 	if err != nil {
 		return field.ErrorList{field.Invalid(fldPath, value, fmt.Sprintf("must be a well-formed image reference: %v", err))}
