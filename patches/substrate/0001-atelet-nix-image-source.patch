+package nixref
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	const built = "/nix/store/0c0zb1l7mqvdrsgjq7b9vl0g9cyfh3q1-agent-env"
+	tests := []struct {
+		name     string
+		ref      string
+		wantPath string
+		wantNix  bool
+		wantErr  bool
+	}{
+		{"oci reference", "registry.example/app@sha256:abc", "", false, false},
+		{"built store path", "nix:" + built, built, true, false},
+		// Realising a derivation builds on the node; only built paths are images.
+		{"derivation", "nix:" + built + ".drv", "", true, true},
+		{"path below a store path", "nix:" + built + "/bin/sh", "", true, true},
+		{"outside the store", "nix:/etc/passwd", "", true, true},
+		{"traversal", "nix:/nix/store/../../etc/passwd", "", true, true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, isNix, err := Parse(tc.ref)
+			if got != tc.wantPath || isNix != tc.wantNix || (err != nil) != tc.wantErr {
+				t.Errorf("Parse(%q) = %q, %v, %v; want %q, %v, error=%v", tc.ref, got, isNix, err, tc.wantPath, tc.wantNix, tc.wantErr)
+			}
+		})
+	}
+}
