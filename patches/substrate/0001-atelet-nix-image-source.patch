+// fakeNode is a store directory plus a nix-store stand-in that answers for it.
+type fakeNode struct {
+	storeDir string
+	closure  []string
+	calls    [][]string
+	fail     error
+	// realiseStderr, when set, makes --realise fail the way nix-store does,
+	// printing it on stderr.
+	realiseStderr string
+}
+
+func (n *fakeNode) run(_ context.Context, args ...string) ([]byte, error) {
+	n.calls = append(n.calls, args)
+	if n.fail != nil {
+		return nil, n.fail
+	}
+	if args[0] == "--realise" && n.realiseStderr != "" {
+		return nil, &commandError{command: "nix-store", args: args, err: errors.New("exit status 1"), stderr: n.realiseStderr}
+	}
+	if args[0] == "--query" {
+		return []byte(strings.Join(n.closure, "\n") + "\n"), nil
+	}
+	if args[0] == "--realise" {
+		// Like nix-store --add-root: the root is a link to the store path.
+		if err := os.Symlink(args[1], args[3]); err != nil && !errors.Is(err, os.ErrExist) {
+			return nil, err
+		}
+	}
+	return nil, nil
+}
+
+func writeFile(t *testing.T, path, content string, mode os.FileMode) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), mode); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func symlink(t *testing.T, target, path string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(target, path); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// newFakeNode lays out a closure shaped like a buildEnv: the root path's bin
+// and etc are links into other store paths, by absolute /nix/store targets.
+// A fourth path belongs to no closure.
+func newFakeNode(t *testing.T) (*fakeNode, string) {
+	t.Helper()
+	base := t.TempDir()
+	store := filepath.Join(base, "store")
+	writeFile(t, filepath.Join(store, bashBase, "bin", "bash"), "#!bash", 0o555)
+	symlink(t, "bash", filepath.Join(store, bashBase, "bin", "sh"))
+	writeFile(t, filepath.Join(store, etcBase, "etc", "passwd"), "agent:x:1000:1000::/home/agent:/bin/sh\n", 0o444)
+	symlink(t, LogicalStoreDir+"/"+bashBase+"/bin", filepath.Join(store, envBase, "bin"))
+	symlink(t, LogicalStoreDir+"/"+etcBase+"/etc", filepath.Join(store, envBase, "etc"))
+	writeFile(t, filepath.Join(store, envBase, ConfigFileName),
+		`{"Entrypoint":["/bin/sh"],"Env":["PATH=/bin"],"WorkingDir":"/work","User":"agent"}`, 0o444)
+	writeFile(t, filepath.Join(store, otherBase, "secret"), "other tenant", 0o444)
+	return &fakeNode{
+		storeDir: store,
+		closure:  []string{LogicalStoreDir + "/" + bashBase, LogicalStoreDir + "/" + etcBase, envPath},
+	}, filepath.Join(base, "views")
+}
+
+func newStore(t *testing.T, node *fakeNode, viewDir string, opts ...Option) *Store {
+	t.Helper()
+	s, err := New(viewDir, append([]Option{WithStoreDir(node.storeDir), WithRunner(node.run)}, opts...)...)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return s
+}
+
+func TestEnsureImageBuildsClosureView(t *testing.T) {
+	node, viewDir := newFakeNode(t)
+	s := newStore(t, node, viewDir, WithMountDir("/var/lib/ate/nix-views"))
+
+	img, workerLayers, err := s.EnsureImage(t.Context(), envPath)
+	if err != nil {
+		t.Fatalf("EnsureImage: %v", err)
+	}
+
+	if want := []string{"/var/lib/ate/nix-views/views/" + envBase}; !slices.Equal(workerLayers, want) {
+		t.Errorf("worker layers = %v, want %v (rooted at the workers' mount dir)", workerLayers, want)
+	}
+	if got := img.Config.Entrypoint; !slices.Equal(got, []string{"/bin/sh"}) {
+		t.Errorf("Config.Entrypoint = %v, want [/bin/sh]", got)
+	}
+	if img.Config.WorkingDir != "/work" || img.Config.User != "agent" {
+		t.Errorf("Config = %+v, want WorkingDir /work and User agent", img.Config)
+	}
+
+	fsDir := filepath.Join(viewDir, "views", envBase, "fs")
+
+	// A file in the view is the store's own inode, not a copy.
+	storeFile, err := os.Stat(filepath.Join(node.storeDir, bashBase, "bin", "bash"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	viewFile, err := os.Stat(filepath.Join(fsDir, "nix", "store", bashBase, "bin", "bash"))
+	if err != nil {
+		t.Fatalf("closure path missing from view: %v", err)
+	}
+	if !os.SameFile(storeFile, viewFile) {
+		t.Error("view file is a copy of the store file, want a hard link")
+	}
+
+	// Symlinks inside store paths are kept as they are.
+	if link, err := os.Readlink(filepath.Join(fsDir, "nix", "store", bashBase, "bin", "sh")); err != nil || link != "bash" {
+		t.Errorf("Readlink(bin/sh) = %q, %v; want \"bash\"", link, err)
+	}
+
+	// The root path's directories are real directories whose entries point
+	// into the store, so the worker can add files beside them.
+	if info, err := os.Lstat(filepath.Join(fsDir, "bin")); err != nil || !info.IsDir() {
+		t.Fatalf("/bin in view: %v, %v; want a real directory", info, err)
+	}
+	if link, err := os.Readlink(filepath.Join(fsDir, "bin", "bash")); err != nil || link != envPath+"/bin/bash" {
+		t.Errorf("Readlink(/bin/bash) = %q, %v; want %q", link, err, envPath+"/bin/bash")
+	}
+
+	// atelet reads /etc/passwd without following links out of the layer.
+	b, err := img.ReadFile("etc/passwd")
+	if err != nil {
+		t.Fatalf("img.ReadFile(etc/passwd): %v", err)
+	}
+	if !strings.HasPrefix(string(b), "agent:x:1000:") {
+		t.Errorf("etc/passwd = %q", b)
+	}
+
+	for _, d := range []string{"proc", "sys", "dev", "tmp"} {
+		if info, err := os.Stat(filepath.Join(fsDir, d)); err != nil || !info.IsDir() {
+			t.Errorf("view lacks mount point /%s: %v", d, err)
+		}
+	}
+
+	// Only the closure is visible: nothing else from the node's store.
+	if _, err := os.Lstat(filepath.Join(fsDir, "nix", "store", otherBase)); !errors.Is(err, os.ErrNotExist) {
+		t.Errorf("path outside the closure is in the view (err = %v)", err)
+	}
+
+	if want := []string{"--realise", envPath, "--add-root", filepath.Join(viewDir, "gcroots", envBase)}; !slices.Equal(node.calls[0], want) {
+		t.Errorf("first nix-store call = %v, want %v", node.calls[0], want)
+	}
+}
+
+func TestEnsureImageReusesView(t *testing.T) {
+	node, viewDir := newFakeNode(t)
+	s := newStore(t, node, viewDir)
+	if _, _, err := s.EnsureImage(t.Context(), envPath); err != nil {
+		t.Fatalf("EnsureImage: %v", err)
+	}
+	calls := len(node.calls)
+
+	// A hit must not depend on the daemon or on the store path surviving:
+	// the view keeps the closure's files alive by itself.
+	node.fail = errors.New("daemon down")
+	if err := os.RemoveAll(filepath.Join(node.storeDir, bashBase)); err != nil {
+		t.Fatal(err)
+	}
+	img, _, err := s.EnsureImage(t.Context(), envPath)
+	if err != nil {
+		t.Fatalf("EnsureImage on an existing view: %v", err)
+	}
+	if len(node.calls) != calls {
+		t.Errorf("a cache hit ran nix-store %d more times", len(node.calls)-calls)
+	}
+	b, err := os.ReadFile(filepath.Join(viewDir, "views", envBase, "fs", "nix", "store", bashBase, "bin", "bash"))
+	if err != nil || string(b) != "#!bash" {
+		t.Errorf("view file after its store path was deleted = %q, %v", b, err)
+	}
+	if img.Config.User != "agent" {
+		t.Errorf("Config.User on a hit = %q, want agent", img.Config.User)
+	}
+}
+
+func TestEnsureImageFailures(t *testing.T) {
+	tests := []struct {
+		name    string
+		path    string
+		mutate  func(*fakeNode)
+		wantErr string
+	}{
+		{"not a store path", "/etc/passwd", nil, "invalid nix store path"},
+		{"derivation", LogicalStoreDir + "/" + envBase + ".drv", nil, "is a derivation"},
+		{"substitution fails", envPath, func(n *fakeNode) { n.fail = errors.New("no signature trusted") }, "no signature trusted"},
+		{"closure lists a path outside the store", envPath, func(n *fakeNode) { n.closure = append(n.closure, "/nix/store/../../etc") }, "not a store path"},
+		{"closure omits the root", envPath, func(n *fakeNode) { n.closure = n.closure[:2] }, "does not include the path itself"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			node, viewDir := newFakeNode(t)
+			if tc.mutate != nil {
+				tc.mutate(node)
+			}
+			s := newStore(t, node, viewDir)
+			_, _, err := s.EnsureImage(t.Context(), tc.path)
+			if err == nil || !strings.Contains(err.Error(), tc.wantErr) {
+				t.Fatalf("EnsureImage error = %v, want one containing %q", err, tc.wantErr)
+			}
+			// A failed build leaves no GC root: with no view, nothing would
+			// ever evict it and the closure would stay pinned.
+			if entries, _ := os.ReadDir(filepath.Join(viewDir, "gcroots")); len(entries) != 0 {
+				t.Errorf("failed build left %d GC roots behind", len(entries))
+			}
+			if tc.name == "derivation" && len(node.calls) != 0 {
+				t.Errorf("nix-store was called for a derivation: %v", node.calls)
+			}
+			// A failed build leaves no view a later call could mistake for complete.
+			if entries, _ := os.ReadDir(filepath.Join(viewDir, "views")); len(entries) != 0 {
+				t.Errorf("failed build left %d views behind", len(entries))
+			}
+		})
+	}
+}
+
+func TestRootLinksCannotEscapeTheView(t *testing.T) {
+	node, viewDir := newFakeNode(t)
+	// A closure whose root tries to pass the host's files off as its own.
+	outside := filepath.Join(t.TempDir(), "host-etc")
+	writeFile(t, filepath.Join(outside, "passwd"), "root:x:0:0::/root:/bin/sh\n", 0o444)
+	if err := os.Remove(filepath.Join(node.storeDir, envBase, "etc")); err != nil {
+		t.Fatal(err)
+	}
+	symlink(t, "../../../../../../../../../../.."+outside, filepath.Join(node.storeDir, envBase, "etc"))
+	if err := os.Remove(filepath.Join(node.storeDir, envBase, ConfigFileName)); err != nil {
+		t.Fatal(err)
+	}
+	symlink(t, fmt.Sprintf("../../../../../../../../../..%s/passwd", outside), filepath.Join(node.storeDir, envBase, ConfigFileName))
+
+	s := newStore(t, node, viewDir)
+	img, _, err := s.EnsureImage(t.Context(), envPath)
+	if err != nil {
+		t.Fatalf("EnsureImage: %v", err)
+	}
+	if b, err := img.ReadFile("etc/passwd"); err == nil {
+		t.Errorf("read the host's passwd through the view: %q", b)
+	}
+	if len(img.Config.Entrypoint) != 0 || img.Config.User != "" {
+		t.Errorf("config was read from outside the view: %+v", img.Config)
+	}
+}
+
+func TestEvictUnused(t *testing.T) {
+	node, viewDir := newFakeNode(t)
+	s := newStore(t, node, viewDir, WithMinAge(time.Hour))
+	if _, _, err := s.EnsureImage(t.Context(), envPath); err != nil {
+		t.Fatalf("EnsureImage: %v", err)
+	}
+	view := filepath.Join(viewDir, "views", envBase)
+	gcRoot := filepath.Join(viewDir, "gcroots", envBase)
+	exists := func(p string) bool { _, err := os.Lstat(p); return err == nil }
+
+	if n, err := s.EvictUnused(nil); err != nil || n != 0 || !exists(view) {
+		t.Fatalf("EvictUnused on a young view = %d, %v (view exists: %v); want it kept", n, err, exists(view))
+	}
+
+	old := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(view, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := s.EvictUnused(map[string]bool{envBase: true}); err != nil || n != 0 || !exists(view) {
+		t.Fatalf("EvictUnused on a view in use = %d, %v (view exists: %v); want it kept", n, err, exists(view))
+	}
+
+	if n, err := s.EvictUnused(nil); err != nil || n != 1 {
+		t.Fatalf("EvictUnused = %d, %v; want 1 removed", n, err)
+	}
+	if exists(view) || exists(gcRoot) {
+		t.Errorf("after eviction: view exists %v, gc root exists %v; want both gone", exists(view), exists(gcRoot))
+	}
+	// The store itself is untouched: eviction removes links, not content.
+	if b, err := os.ReadFile(filepath.Join(node.storeDir, bashBase, "bin", "bash")); err != nil || string(b) != "#!bash" {
+		t.Errorf("store file after eviction = %q, %v", b, err)
+	}
+
+	// An evicted view is rebuilt on demand.
+	if _, _, err := s.EnsureImage(t.Context(), envPath); err != nil || !exists(view) {
+		t.Errorf("EnsureImage after eviction: %v (view exists: %v)", err, exists(view))
+	}
+}
+
+func TestNewClearsUnfinishedViews(t *testing.T) {
+	node, viewDir := newFakeNode(t)
+	writeFile(t, filepath.Join(viewDir, "tmp", envBase+"-123", "fs", "half"), "x", 0o444)
+	newStore(t, node, viewDir)
+	if entries, err := os.ReadDir(filepath.Join(viewDir, "tmp")); err != nil || len(entries) != 0 {
+		t.Errorf("tmp after New holds %d entries (%v), want none", len(entries), err)
+	}
+}
