+
+package main
+
+import (
+	"context"
+	"log/slog"
+	"time"
+
+	"github.com/spf13/pflag"
+	"go.ate.dev/substrate/internal/imagecache"
+	"go.ate.dev/substrate/internal/niximage"
+)
+
+var (
+	nixViewDir      = pflag.String("nix-view-dir", "", "Directory for Nix closure views. Setting it enables \"nix:/nix/store/...\" image references: atelet asks the node's Nix daemon to substitute the closure and hard-links it into a per-closure view here. Must be on the same mount as /nix/store as atelet sees them (hard links cannot cross mounts), e.g. /nix/var/ate/views with the host's /nix mounted into atelet. Empty disables Nix images.")
+	nixViewMountDir = pflag.String("nix-view-mount-dir", "", "Path at which the worker pods see --nix-view-dir, when it differs (e.g. the node bind-mounts the view directory under /var/lib/ate so it reaches the workers through the shared base mount). Empty means the same path.")
+	nixStoreCommand = pflag.String("nix-store-command", "nix-store", "The nix-store executable atelet runs (against the daemon) to substitute closures and list their paths.")
+)
+
+// nixRootSet is what the view GC needs from *imagecache.Store.
+type nixRootSet interface {
+	InUse() (imagecache.RootSet, error)
+}
+
+// openNixImages opens the Nix view store when --nix-view-dir is set and
+// starts its GC loop. It returns nil when Nix images are disabled.
+func openNixImages(ctx context.Context, roots nixRootSet) (*niximage.Store, error) {
+	if *nixViewDir == "" {
+		return nil, nil
+	}
+	store, err := niximage.New(*nixViewDir,
+		niximage.WithMountDir(*nixViewMountDir),
+		niximage.WithNixStoreCommand(*nixStoreCommand),
+		niximage.WithMinAge(*imageCacheMinAge),
+	)
+	if err != nil {
+		return nil, err
+	}
+	if *imageCacheGCPeriod > 0 {
+		go runNixViewGC(ctx, store, roots, *imageCacheGCPeriod)
+	}
+	return store, nil
+}
+
+// runNixViewGC removes views no bundle uses, on the image cache GC's period.
+// Views are cheap to rebuild (links only), so there is no watermark: an
+// unused view goes once it is older than the minimum age. A view holds its
+// closure's GC root, so this is also what lets the Nix collector reclaim
+// closures no actor on the node runs.
+func runNixViewGC(ctx context.Context, store *niximage.Store, roots nixRootSet, period time.Duration) {
+	ticker := time.NewTicker(period)
+	defer ticker.Stop()
+	for {
+		nixViewGCPass(ctx, store, roots)
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+func nixViewGCPass(ctx context.Context, store *niximage.Store, roots nixRootSet) {
+	// An incomplete root set fails toward deleting a running actor's view,
+	// so a pass with one does nothing.
+	rs, err := roots.InUse()
+	if err != nil {
+		slog.WarnContext(ctx, "Nix view GC: root set incomplete; skipping this pass", slog.Any("err", err))
+		return
+	}
+	removed, err := store.EvictUnused(rs.LayerHexes)
+	if err != nil {
+		slog.WarnContext(ctx, "Nix view GC: pass finished with errors", slog.Int("removed", removed), slog.Any("err", err))
+		return
+	}
+	if removed > 0 {
+		slog.InfoContext(ctx, "Nix view GC: removed unused views", slog.Int("removed", removed))
+	}
+}
