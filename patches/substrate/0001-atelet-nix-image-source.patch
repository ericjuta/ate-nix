+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package nixref parses image references that name a Nix store path instead
+// of an OCI image. It has no dependencies so API validation can share it with
+// the node-side image source (internal/niximage).
+package nixref
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+const (
+	// Scheme prefixes an image reference that names a Nix store path.
+	Scheme = "nix:"
+
+	// StoreDir is the only store directory a reference may name, and where
+	// the closure appears inside the actor. Store paths embed it, so it is
+	// not configurable.
+	StoreDir = "/nix/store"
+)
+
+// storePathBase matches the base name of a store path: a 32-character
+// nix-base32 hash, a dash, and a name of the characters Nix allows, not
+// starting with a dot.
+var storePathBase = regexp.MustCompile(`^[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+_?=-][A-Za-z0-9+._?=-]{0,210}$`)
+
+// Parse reports whether ref is a Nix image reference and, if so, returns the
+// store path it names. A reference with the nix: scheme that does not name a
+// well-formed store path directly under /nix/store is an error.
+func Parse(ref string) (storePath string, isNix bool, err error) {
+	rest, ok := strings.CutPrefix(ref, Scheme)
+	if !ok {
+		return "", false, nil
+	}
+	if !IsStorePath(rest) {
+		return "", true, fmt.Errorf("nix image reference %q: want %s%s/<hash>-<name>", ref, Scheme, StoreDir)
+	}
+	if IsDerivation(rest) {
+		return "", true, fmt.Errorf("nix image reference %q names a derivation (.drv), not a built store path", ref)
+	}
+	return rest, true, nil
+}
+
+// IsStorePath reports whether p is a well-formed path directly under
+// /nix/store.
+func IsStorePath(p string) bool {
+	base, ok := strings.CutPrefix(p, StoreDir+"/")
+	return ok && storePathBase.MatchString(base)
+}
+
+// IsDerivation reports whether p names a derivation file. Realising one makes
+// Nix build its outputs, which a node must never do for an image: an image is
+// a built path that the node only fetches.
+func IsDerivation(p string) bool {
+	return strings.HasSuffix(p, ".drv")
+}
