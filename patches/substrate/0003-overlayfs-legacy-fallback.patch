+
+package imagecache
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestLegacyOverlayOptions(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		lowers       []string
+		upper, work  string
+		want, errSub string
+	}{
+		{name: "writable", lowers: []string{"/top", "/bottom"}, upper: "/upper", work: "/work", want: "lowerdir=/top:/bottom,upperdir=/upper,workdir=/work,volatile"},
+		{name: "read-only", lowers: []string{"/top", "/bottom"}, want: "lowerdir=/top:/bottom,volatile"},
+		{name: "no layers", errSub: "at least one lowerdir"},
+		{name: "missing work", lowers: []string{"/lower"}, upper: "/upper", errSub: "together"},
+		{name: "missing upper", lowers: []string{"/lower"}, work: "/work", errSub: "together"},
+		{name: "relative", lowers: []string{"relative"}, errSub: "cannot encode"},
+		{name: "empty path", lowers: []string{""}, errSub: "cannot encode"},
+		{name: "colon", lowers: []string{"/one:/two"}, errSub: "cannot encode"},
+		{name: "comma", lowers: []string{"/one,two"}, errSub: "cannot encode"},
+		{name: "backslash", lowers: []string{`/one\two`}, errSub: "cannot encode"},
+		{name: "NUL", lowers: []string{"/one\x00two"}, errSub: "cannot encode"},
+		{name: "upper delimiter", lowers: []string{"/lower"}, upper: "/upper,volatile", work: "/work", errSub: "cannot encode"},
+		{name: "work delimiter", lowers: []string{"/lower"}, upper: "/upper", work: "/work:other", errSub: "cannot encode"},
+		{name: "page limit", lowers: []string{"/" + strings.Repeat("x", os.Getpagesize())}, errSub: "page limit"},
+		{name: "many layers", lowers: make([]string, os.Getpagesize()), errSub: "cannot encode"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := legacyOverlayOptions(tc.lowers, tc.upper, tc.work)
+			if tc.errSub != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.errSub) {
+					t.Fatalf("error=%v, want %q", err, tc.errSub)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("options=%q error=%v, want %q", got, err, tc.want)
+			}
+		})
+	}
+}
+
+func TestLegacyOverlayOptionsPageBoundary(t *testing.T) {
+	fixed := len("lowerdir=,volatile")
+	lower := "/" + strings.Repeat("x", os.Getpagesize()-fixed-2)
+	options, err := legacyOverlayOptions([]string{lower}, "", "")
+	if err != nil || len(options) != os.Getpagesize()-1 {
+		t.Fatalf("page-minus-one options length=%d error=%v", len(options), err)
+	}
+	if _, err := legacyOverlayOptions([]string{lower + "x"}, "", ""); err == nil {
+		t.Fatal("accepted options at the page-size limit")
+	}
+}
+
+// Run explicitly as root with CAP_SYS_ADMIN on both a 6.1 kernel and a kernel
+// with lowerdir+ support. This always exercises mount(2).
+func TestLegacyOverlayMount(t *testing.T) {
+	testOverlayMount(t, mountOverlayLegacy)
+}
+
+// On an older kernel this proves fallback selection; on a newer kernel it
+// proves the default incremental path still composes the same writable view.
+func TestOverlayAutomaticMount(t *testing.T) {
+	testOverlayMount(t, mountOverlay)
+}
+
+func testOverlayMount(t *testing.T, mount func(string, []string, string, string) error) {
+	t.Helper()
+	if os.Geteuid() != 0 {
+		t.Skip("requires root and CAP_SYS_ADMIN")
+	}
+	root := t.TempDir()
+	for _, dir := range []string{"lower", "upper", "work", "merged"} {
+		if err := os.Mkdir(filepath.Join(root, dir), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	lower := filepath.Join(root, "lower")
+	if err := os.WriteFile(filepath.Join(lower, "file"), []byte("lower"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	merged := filepath.Join(root, "merged")
+	if err := mount(merged, []string{lower}, filepath.Join(root, "upper"), filepath.Join(root, "work")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := unix.Unmount(merged, 0); err != nil {
+			t.Errorf("unmount: %v", err)
+		}
+	})
+	if got, err := os.ReadFile(filepath.Join(merged, "file")); err != nil || string(got) != "lower" {
+		t.Fatalf("merged file=%q error=%v", got, err)
+	}
+	if err := os.WriteFile(filepath.Join(merged, "file"), []byte("upper"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := os.ReadFile(filepath.Join(lower, "file")); err != nil || string(got) != "lower" {
+		t.Fatalf("write modified the shared lower: %q error=%v", got, err)
+	}
+}
