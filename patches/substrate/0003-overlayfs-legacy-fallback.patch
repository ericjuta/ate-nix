+
+func mountOverlayLegacy(mountpoint string, lowers []string, upper, work string) error {
+	data, err := legacyOverlayOptions(lowers, upper, work)
+	if err != nil {
+		return err
+	}
+	if err := unix.Mount("overlay", mountpoint, "overlay", 0, data); err != nil {
+		return fmt.Errorf("while mounting overlay with mount(2): %w", err)
+	}
+	return nil
+}
+
+// legacyOverlayOptions refuses paths the option string cannot represent
+// unambiguously. The incremental API accepts these paths individually, so this
+// restriction applies only to kernels taking the compatibility path.
+func legacyOverlayOptions(lowers []string, upper, work string) (string, error) {
+	if len(lowers) == 0 {
+		return "", fmt.Errorf("legacy overlay mount requires at least one lowerdir")
+	}
+	if (upper == "") != (work == "") {
+		return "", fmt.Errorf("legacy overlay mount requires upperdir and workdir together")
+	}
+	size := len("lowerdir=") + len(lowers) - 1 + len(",volatile")
+	checkPath := func(path string) error {
+		if !filepath.IsAbs(path) || strings.ContainsAny(path, ":,\\\x00") {
+			return fmt.Errorf("legacy overlay cannot encode path %q: use absolute paths without colon, comma, backslash, or NUL", path)
+		}
+		// Bound the sum before adding, not after allocating the option string.
+		if len(path) >= os.Getpagesize()-size {
+			return fmt.Errorf("legacy overlay mount options exceed the %d-byte page limit; use fewer layers or a kernel with lowerdir+ support", os.Getpagesize())
+		}
+		size += len(path)
+		return nil
+	}
+	for _, lower := range lowers {
+		if err := checkPath(lower); err != nil {
+			return "", err
+		}
+	}
+	if upper != "" {
+		size += len(",upperdir=,workdir=")
+		if err := checkPath(upper); err != nil {
+			return "", err
+		}
+		if err := checkPath(work); err != nil {
+			return "", err
+		}
+	}
+
+	var data strings.Builder
+	data.Grow(size)
+	data.WriteString("lowerdir=")
+	for i, lower := range lowers {
+		if i > 0 {
+			data.WriteByte(':')
+		}
+		data.WriteString(lower)
+	}
+	if upper != "" {
+		data.WriteString(",upperdir=")
+		data.WriteString(upper)
+		data.WriteString(",workdir=")
+		data.WriteString(work)
+	}
+	data.WriteString(",volatile")
+	return data.String(), nil
 }
 
