 // An empty upper mounts the overlay without a writable layer, which overlayfs
 // makes read-only.
 //
-// Requires overlayfs's "lowerdir+" option: Linux 6.7+, or 6.6.23+ where it was
-// backported.
+// The incremental API requires Linux 6.7+, or 6.6.23+ where lowerdir+ was
+// backported. Older kernels fall back to mount(2) within its single-page limit.
+// Permission, upper/work-directory, and mount-attachment errors do not trigger
+// the fallback.
 // https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=24e16e385f2272b1a9df51337a5c32d28a29c7ad
 // https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/commit/?id=cc0918b3582c98f12cfb30bf7496496d14bff3e9
 func mountOverlay(mountpoint string, lowers []string, upper, work string) error {
+	err := mountOverlayNew(mountpoint, lowers, upper, work)
+	if !errors.Is(err, errOverlayMountAPIUnsupported) {
+		return err
+	}
+	if legacyErr := mountOverlayLegacy(mountpoint, lowers, upper, work); legacyErr != nil {
+		return fmt.Errorf("incremental overlay mount failed: %w; legacy mount also failed: %w", err, legacyErr)
+	}
+	return nil
+}
+
+var errOverlayMountAPIUnsupported = errors.New("incremental overlay mount API is unavailable")
+
+func mountOverlayNew(mountpoint string, lowers []string, upper, work string) error {
 	fsfd, err := unix.Fsopen("overlay", unix.FSOPEN_CLOEXEC)
 	if err != nil {
+		if errors.Is(err, unix.ENOSYS) || errors.Is(err, unix.EOPNOTSUPP) {
+			return fmt.Errorf("%w: while opening overlay fs context: %w", errOverlayMountAPIUnsupported, err)
+		}
 		return fmt.Errorf("while opening overlay fs context: %w", err)
 	}
 	defer unix.Close(fsfd)
