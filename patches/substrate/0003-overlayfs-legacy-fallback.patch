 	for _, lower := range lowers {
 		if err := set("lowerdir+", lower); err != nil {
+			if errors.Is(err, unix.EINVAL) || errors.Is(err, unix.EOPNOTSUPP) {
+				return fmt.Errorf("%w: %w", errOverlayMountAPIUnsupported, err)
