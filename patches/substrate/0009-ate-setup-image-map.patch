+
+// testNixRef is a nix:0 reference for name, its hash in Nix's base32
+// alphabet.
+func testNixRef(name string) string {
+	return "nix:0/nix/store/0123456789abcdfghijklmnpqrsvwxyz-nix-image-" + name + ".tar"
+}
+
+// testImageMap maps pod archives and independent actor root trees.
+func testImageMap() string {
+	var b strings.Builder
+	b.WriteString("# generated from the Nix image set\n\n")
+	for _, pkg := range images.Components {
+		name := images.ImageName(pkg)
+		ref := testNixRef(name)
+		if strings.HasPrefix(pkg, "demos/") {
+			ref = "nix:/nix/store/0123456789abcdfghijklmnpqrsvwxyz-" + name
+		}
+		b.WriteString(name + " " + ref + "\n")
+	}
+	for _, name := range images.ExtraImages {
+		b.WriteString(name + "   " + testNixRef(name) + "\n")
+	}
+	return b.String()
+}
+
+func TestParseImageMap(t *testing.T) {
+	m, err := images.ParseImageMap([]byte(testImageMap()))
+	if err != nil {
+		t.Fatalf("ParseImageMap() = %v", err)
+	}
+	if got, want := len(m.Images), len(images.Components)+len(images.ExtraImages); got != want {
+		t.Errorf("mapped %d images, want %d", got, want)
+	}
+	if len(m.References) != 0 {
+		t.Errorf("mapped references %v from a map of image names", m.References)
+	}
+	if m.Images["atelet"] != testNixRef("atelet") {
+		t.Errorf("atelet = %q, want %q", m.Images["atelet"], testNixRef("atelet"))
+	}
+
+	pinned := "ghcr.io/x/atelet@sha256:" + strings.Repeat("1", 64)
+	upstream := "postgres:18-alpine@sha256:" + strings.Repeat("2", 64)
+	for name, content := range map[string]string{
+		"unknown image":                "atelet-sidecar " + testNixRef("x"),
+		"mapped twice":                 "atelet " + testNixRef("a") + "\natelet " + testNixRef("b"),
+		"actor given pod archive": "counter " + testNixRef("counter"),
+		"pod given actor root": "atelet nix:/nix/store/0123456789abcdfghijklmnpqrsvwxyz-atelet",
+		"tag only":                     "atelet ghcr.io/x/atelet:v1",
+		"malformed nix reference":      "atelet nix:0/nix/store/short-nix-image-atelet.tar",
+		"nix reference not an archive": "atelet nix:0/nix/store/0123456789abcdfghijklmnpqrsvwxyz-atelet",
+		"three fields":                 "atelet " + pinned + " extra",
+		"one field":                    "atelet",
+		"empty":                        "# nothing\n",
+		"reference mapped twice":       upstream + " " + testNixRef("a") + "\n" + upstream + " " + testNixRef("b"),
+		"replaced reference by tag":    "postgres:18-alpine " + testNixRef("postgres"),
+		"replaced reference malformed": "Postgres:18@sha256:" + strings.Repeat("2", 64) + " " + testNixRef("postgres"),
+		"replaced nix reference":       testNixRef("postgres") + " " + testNixRef("other"),
+		"replacement by tag":           upstream + " ghcr.io/x/postgres:18",
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := images.ParseImageMap([]byte(content)); err == nil {
+				t.Errorf("ParseImageMap(%q) accepted it", content)
+			}
+		})
+	}
+	if m, err := images.ParseImageMap([]byte("atelet " + pinned)); err != nil || m.Images["atelet"] != pinned {
+		t.Errorf("ParseImageMap(digest-pinned) = %v, %v", m, err)
+	}
+	// An exact reference may be the map's only entry.
+	m, err = images.ParseImageMap([]byte(upstream + " " + testNixRef("postgres") + "\n"))
+	if err != nil {
+		t.Fatalf("ParseImageMap(reference) = %v", err)
+	}
+	if len(m.Images) != 0 || len(m.References) != 1 || m.References[upstream] != testNixRef("postgres") {
+		t.Errorf("ParseImageMap(reference) = %+v, want only %s replaced", m, upstream)
+	}
+}
+
+// An exact reference is replaced wherever it stands as a whole reference, and
+// nowhere else.
+func TestImageMapReplacesExactReferences(t *testing.T) {
+	digest := "@sha256:" + strings.Repeat("3", 64)
+	upstream := "postgres:18-alpine" + digest
+	m, err := images.ParseImageMap([]byte(upstream + " " + testNixRef("postgres") + "\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest := strings.Join([]string{
+		"containers:",
+		"- image: " + upstream,
+		`- image: "` + upstream + `"`,
+		"- {name: x, image: '" + upstream + "'}",
+		// Other references the mapped one is part of stay as written.
+		"- image: docker.io/library/" + upstream,
+		"- image: postgres:18-alpine",
+		"- image: my" + upstream,
+		"- image: " + upstream + "0",
+		"",
+	}, "\n")
+	want := strings.Join([]string{
+		"containers:",
+		"- image: " + testNixRef("postgres"),
+		`- image: "` + testNixRef("postgres") + `"`,
+		"- {name: x, image: '" + testNixRef("postgres") + "'}",
+		"- image: docker.io/library/" + upstream,
+		"- image: postgres:18-alpine",
+		"- image: my" + upstream,
+		"- image: " + upstream + "0",
+		"",
+	}, "\n")
+	if got := string(m.ReplaceReferences([]byte(manifest))); got != want {
+		t.Errorf("ReplaceReferences() =\n%s\nwant\n%s", got, want)
+	}
+	// Without references the manifest is returned as it was.
+	names, err := images.ParseImageMap([]byte(testImageMap()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := string(names.ReplaceReferences([]byte(manifest))); got != manifest {
+		t.Errorf("ReplaceReferences() without references changed the manifest:\n%s", got)
+	}
+}
+
+// pinnedImage matches a container image a manifest pins by digest, which the
+// source manifests do only for third-party images (components are ko://
+// references, nix:0 references carry no digest).
+var pinnedImage = regexp.MustCompile(`(?m)^\s*(?:-\s+)?image:\s*["']?([^\s"']+@sha256:[0-9a-f]{64})`)
+
+// Every third-party image the kind install deploys -- the bundled PostgreSQL,
+// RustFS and its bucket job, the observability stack -- resolves from a map
+// that names its exact references, through the same paths ate-setup applies
+// them by: the system manifests through the resolver, PostgreSQL through
+// ReplaceReferences.
+func TestThirdPartyImagesResolveFromAnImageMap(t *testing.T) {
+	root, err := config.RepoRoot()
+	if err != nil {
+		t.Fatalf("resolving repo root: %v", err)
+	}
+	installDir := filepath.Join(root, "manifests", "ate-install")
+	files := []string{
+		filepath.Join(installDir, "postgres", "postgres.yaml"),
+		filepath.Join(installDir, "kind", "rustfs.yaml"),
+		filepath.Join(installDir, "kind", "otel-collector.yaml"),
+		filepath.Join(installDir, "kind", "prometheus.yaml"),
+	}
+	manifests := map[string][]byte{}
+	var upstream []string
+	for _, file := range files {
+		manifest, err := kube.ReadPath(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		manifests[file] = manifest
+		for _, match := range pinnedImage.FindAllStringSubmatch(string(manifest), -1) {
+			if !slices.Contains(upstream, match[1]) {
+				upstream = append(upstream, match[1])
+			}
+		}
+	}
+	// postgres (both containers name one reference), rustfs, aws-cli,
+	// otel-collector-contrib, jaeger, prometheus.
+	if len(upstream) != 6 {
+		t.Fatalf("found third-party images %v, want 6", upstream)
+	}
+	content := testImageMap()
+	for i, ref := range upstream {
+		content += ref + " " + testNixRef("third-party-"+string(rune('a'+i))) + "\n"
+	}
+	m, err := images.ParseImageMap([]byte(content))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resolver := images.NewPrebuilt(images.Source{MapFile: "/m", Map: m}, newStubRegistry().digest)
+	for _, file := range files {
+		t.Run(filepath.Base(file), func(t *testing.T) {
+			out, err := resolver.ResolveBytes(context.Background(), manifests[file])
+			if err != nil {
+				t.Fatalf("ResolveBytes() = %v", err)
+			}
+			if !slices.Equal(out, m.ReplaceReferences(manifests[file])) {
+				t.Error("the resolver and ReplaceReferences disagree")
+			}
+			if left := pinnedImage.FindAllStringSubmatch(string(out), -1); len(left) > 0 {
+				t.Errorf("third-party images survived: %v", left)
+			}
+			if !strings.Contains(string(out), "nix:0/nix/store/") {
+				t.Error("no nix:0 reference reached the manifest")
+			}
+			if _, err := kube.DecodeManifestBytes(out); err != nil {
+				t.Errorf("the resolved manifest no longer parses: %v", err)
+			}
+		})
+	}
+}
+
+// An image map installs each reference as written and looks nothing up.
+func TestPrebuiltImageMapPinsVerbatim(t *testing.T) {
+	m, err := images.ParseImageMap([]byte(testImageMap()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	registry := newStubRegistry()
+	p := images.NewPrebuilt(images.Source{MapFile: "/m", Map: m}, registry.digest)
+	got, err := p.Pin(context.Background(), "envoy-dataplane")
+	if err != nil || got != testNixRef("envoy-dataplane") {
+		t.Errorf("Pin(envoy-dataplane) = %q, %v; want %q", got, err, testNixRef("envoy-dataplane"))
+	}
+	delete(m.Images, "atelet")
+	if _, err := p.Pin(context.Background(), "atelet"); err == nil || !strings.Contains(err.Error(), "has no atelet") {
+		t.Errorf("Pin(unmapped) = %v, want the image map named", err)
+	}
+	if len(registry.calls) != 0 {
+		t.Errorf("an image map looked up %v", registry.calls)
+	}
+}
+
+// Every install manifest resolves from a map of Nix references, which
+// reach the manifests unchanged.
+func TestResolveEveryInstallManifestFromAnImageMap(t *testing.T) {
+	root, err := config.RepoRoot()
+	if err != nil {
+		t.Fatalf("resolving repo root: %v", err)
+	}
+	m, err := images.ParseImageMap([]byte(testImageMap()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resolver := images.NewPrebuilt(images.Source{MapFile: "/m", Map: m}, newStubRegistry().digest)
+	installDir := filepath.Join(root, "manifests", "ate-install")
+	entries, err := os.ReadDir(installDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || filepath.Ext(entry.Name()) != ".yaml" {
+			continue
+		}
+		t.Run(entry.Name(), func(t *testing.T) {
+			manifest, err := kube.ReadPath(filepath.Join(installDir, entry.Name()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			out, err := resolver.ResolveBytes(context.Background(), manifest)
+			if err != nil {
+				t.Fatalf("ResolveBytes() = %v", err)
+			}
+			if refs := koRefPattern.FindAllString(string(out), -1); len(refs) > 0 {
+				t.Errorf("unresolved references survived: %v", refs)
+			}
+			if strings.Contains(string(manifest), "ko://") && !strings.Contains(string(out), "nix:0/nix/store/") {
+				t.Error("no nix:0 reference reached the manifest")
+			}
+			if _, err := kube.DecodeManifestBytes(out); err != nil {
+				t.Errorf("the resolved manifest no longer parses: %v", err)
+			}
+		})
+	}
+}
