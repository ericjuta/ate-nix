+// limitations under the License.
+
+package images
+
+// A deployment that builds its images with Nix already knows each component's exact
+// reference, so the installer takes them as written instead of resolving
+// REPO/name:TAG against a registry. Each reference is installed verbatim:
+// nix:0 archives are resolved by nix-snapshotter for pods and workers;
+// nix:/ root trees are resolved by atelet for actors, never by this tool.
+//
+// The same deployment builds the third-party images the manifests pin by
+// digest (PostgreSQL, RustFS, the observability stack), so a map also
+// replaces an exact upstream reference with its own build.
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"os"
+	"regexp"
+	"slices"
+	"strings"
+
+	"github.com/distribution/reference"
+
+	"go.ate.dev/substrate/internal/nixref"
+)
+
+const (
+	// imageMapLinesMax bounds an image map: one line per component, with
+	// room for comments.
+	imageMapLinesMax = 1024
+	// imageMapLineMax bounds one line: a name and a reference of at most
+	// 512 bytes (the API's image reference bound).
+	imageMapLineMax = 1024
+)
+
+// ExtraImages are the images the manifests reach other than by ko://
+// reference, which an image map may name too: envoy-dataplane is built from
+// a Dockerfile.
+var ExtraImages = []string{"envoy-dataplane"}
+
+// mappable reports whether name is an image an install can use.
+func mappable(name string) bool {
+	if slices.Contains(ExtraImages, name) {
+		return true
+	}
+	return slices.ContainsFunc(Components, func(pkg string) bool { return ImageName(pkg) == name })
+}
+
+// ImageMap is the content of an image map file (see ReadImageMap).
+type ImageMap struct {
+	// Images maps an image name (see ImageName and ExtraImages) to the
+	// reference that replaces the image's ko:// reference.
+	Images map[string]string
+	// References maps an exact reference the manifests name, such as
+	// postgres:18-alpine@sha256:..., to the reference installed in its place.
+	References map[string]string
+}
+
+// ReadImageMap reads an image map file: one "<image> <reference>" pair per
+// line. The image is either a component's image name (see ImageName) or one of
+// ExtraImages, or an exact image reference pinned by digest that a manifest
+// names other than by ko:// reference. The reference is a nix:0 store
+// archive, an actor nix:/ root, or an OCI digest. Blank lines and lines
+// starting with '#' are ignored. An image may appear once.
+func ReadImageMap(path string) (*ImageMap, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("reading image map: %w", err)
+	}
+	m, err := ParseImageMap(b)
+	if err != nil {
+		return nil, fmt.Errorf("image map %s: %w", path, err)
+	}
+	return m, nil
+}
+
+// ParseImageMap parses the content of an image map (see ReadImageMap).
+func ParseImageMap(content []byte) (*ImageMap, error) {
+	m := &ImageMap{Images: map[string]string{}, References: map[string]string{}}
+	sc := bufio.NewScanner(bytes.NewReader(content))
+	sc.Buffer(make([]byte, 0, imageMapLineMax), imageMapLineMax)
+	for n := 1; sc.Scan(); n++ {
+		if n > imageMapLinesMax {
+			return nil, fmt.Errorf("more than %d lines", imageMapLinesMax)
+		}
+		line := strings.TrimSpace(sc.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		fields := strings.Fields(line)
+		if len(fields) != 2 {
+			return nil, fmt.Errorf("line %d: want \"<image> <reference>\", got %q", n, line)
+		}
+		image, ref := fields[0], fields[1]
+		// An image name is a bare word; anything with a reference's
+		// separators is meant as a reference.
+		target := m.Images
+		if strings.ContainsAny(image, "/:@") {
+			if err := validateReplacedRef(image); err != nil {
+				return nil, fmt.Errorf("line %d: %w", n, err)
+			}
+			target = m.References
+		} else if !mappable(image) {
+			return nil, fmt.Errorf("line %d: %q is not an image the install uses", n, image)
+		}
+		if _, dup := target[image]; dup {
+			return nil, fmt.Errorf("line %d: %s is mapped twice", n, image)
+		}
+		if err := validateMappedRef(ref); err != nil {
+			return nil, fmt.Errorf("line %d: %s: %w", n, image, err)
+		}
+		// Workers are Kubernetes containers. Only demo actor roots use nix:/.
+		actor := slices.ContainsFunc(Components, func(pkg string) bool { return ImageName(pkg) == image && strings.HasPrefix(pkg, "demos/") })
+		if (actor && strings.HasPrefix(ref, "nix:0")) || (!actor && strings.HasPrefix(ref, "nix:/")) {
+			return nil, fmt.Errorf("line %d: %s: reference uses the wrong runtime (actors need nix:/ roots, pods need nix:0 archives)", n, image)
+		}
+		target[image] = ref
+	}
+	if err := sc.Err(); err != nil {
+		return nil, err
+	}
+	if len(m.Images) == 0 && len(m.References) == 0 {
+		return nil, fmt.Errorf("maps no image")
+	}
+	return m, nil
+}
+
+// validateReplacedRef accepts a reference a map may replace: one pinned by
+// digest. A tag alone names whatever was pushed under it last, so the image a
+// map entry stands in for would be unknown.
+func validateReplacedRef(ref string) error {
+	parsed, err := reference.ParseNormalizedNamed(ref)
+	if err != nil {
+		return fmt.Errorf("%q is neither an image the install uses nor an image reference: %w", ref, err)
+	}
+	if _, ok := parsed.(reference.Digested); !ok {
+		return fmt.Errorf("%q is not pinned by digest, so it cannot be replaced", ref)
+	}
+	return nil
+}
+
+// referenceToken matches a maximal run of the characters an image reference
+// is made of (distribution/reference: name components, domain and port, tag,
+// digest algorithm and hex). A manifest reference is always delimited by
+// something else, typically YAML whitespace or quotes.
+var referenceToken = regexp.MustCompile(`[A-Za-z0-9._/:@+-]+`)
+
+// ReplaceReferences replaces every exact reference the map names
+// (References) with its replacement.
+//
+// Matching whole tokens, never substrings, is what makes the textual
+// replacement safe: docker.io/library/postgres:16@sha256:... is a different
+// token from postgres:16@sha256:..., so mapping the short form leaves the long
+// one, and any reference the short one is a prefix or suffix of, as written.
+func (m *ImageMap) ReplaceReferences(manifest []byte) []byte {
+	if len(m.References) == 0 {
+		return manifest
+	}
+	return referenceToken.ReplaceAllFunc(manifest, func(token []byte) []byte {
+		if ref, ok := m.References[string(token)]; ok {
+			return []byte(ref)
+		}
+		return token
+	})
+}
+
+// validateMappedRef accepts what an install can pin: a nix:0 store
+// reference, whose store path pins it, or a registry reference with a
+// digest.
+func validateMappedRef(ref string) error {
+	if rest, ok := strings.CutPrefix(ref, "nix:0"); ok {
+		if !strings.HasSuffix(rest, ".tar") {
+			return fmt.Errorf("nix snapshotter reference %q must name a .tar archive", ref)
+		}
+		_, _, err := nixref.Parse("nix:" + rest)
+		return err
+	}
+	if _, isNix, err := nixref.Parse(ref); isNix {
+		return err
+	}
+	parsed, err := reference.ParseNormalizedNamed(ref)
+	if err != nil {
+		return fmt.Errorf("%q is not an image reference: %w", ref, err)
+	}
+	if _, ok := parsed.(reference.Digested); !ok {
+		return fmt.Errorf("%q is not pinned by digest", ref)
+	}
+	return nil
+}
