+
+package images_test
+
+import (
+    "context"
+    "os"
+    "path/filepath"
+    "strings"
+    "testing"
+
+    "go.ate.dev/substrate/cmd/ate-setup/internal/config"
+    "go.ate.dev/substrate/cmd/ate-setup/internal/images"
+)
+
+// Exercise every map name through the real resolver, including worker pod
+// images and actor templates. No registry operation is permitted.
+func TestImageMapRuntimeRoles(t *testing.T) {
+    m, err := images.ParseImageMap([]byte(testImageMap()))
+    if err != nil { t.Fatal(err) }
+    registry := newStubRegistry()
+    resolver := images.NewPrebuilt(images.Source{MapFile: "/m", Map: m}, registry.digest)
+    for _, component := range images.Components {
+        name := images.ImageName(component)
+        want := m.Images[name]
+        if strings.HasPrefix(component, "demos/") {
+            if !strings.HasPrefix(want, "nix:/nix/store/") { t.Fatalf("actor %s has %s", name, want) }
+        } else if !strings.HasPrefix(want, "nix:0/nix/store/") {
+            t.Fatalf("pod/worker %s has %s", name, want)
+        }
+        got, err := resolver.ResolveBytes(context.Background(), []byte("image: " + images.KoReference(component)))
+        if err != nil || string(got) != "image: " + want { t.Fatalf("%s: %s, %v", component, got, err) }
+    }
+    for _, name := range images.ExtraImages {
+        if got, err := resolver.Pin(context.Background(), name); err != nil || got != m.Images[name] {
+            t.Fatalf("%s: %s, %v", name, got, err)
+        }
+    }
+    if len(registry.calls) != 0 { t.Fatalf("registry calls: %v", registry.calls) }
+}
+
+// The Nix package check supplies the actual generated map, not a synthetic
+// reference fixture. Ordinary upstream test runs do not require Nix outputs.
+func TestBuiltImageMapMatchesInstallSources(t *testing.T) {
+    path := os.Getenv("ATE_TEST_IMAGE_MAP")
+    if path == "" { t.Skip("set ATE_TEST_IMAGE_MAP to check the built Nix image set") }
+    m, err := images.ReadImageMap(path)
+    if err != nil { t.Fatal(err) }
+    if len(m.Images) != len(images.Components)+len(images.ExtraImages) || len(m.References) != 6 {
+        t.Fatalf("map has %d named and %d third-party images", len(m.Images), len(m.References))
+    }
+    root, err := config.RepoRoot()
+    if err != nil { t.Fatal(err) }
+    registry := newStubRegistry()
+    resolver := images.NewPrebuilt(images.Source{MapFile: path, Map: m}, registry.digest)
+    consumed := map[string]bool{}
+    for _, directory := range installTrees {
+        err := filepath.WalkDir(filepath.Join(root, directory), func(path string, entry os.DirEntry, err error) error {
+            if err != nil { return err }
+            ext := filepath.Ext(strings.TrimSuffix(path, ".tmpl"))
+            if entry.IsDir() || (ext != ".yaml" && ext != ".yml" && ext != ".json") { return nil }
+            content, err := os.ReadFile(path)
+            if err != nil { return err }
+            for name := range m.Images {
+                for _, component := range images.Components {
+                    if images.ImageName(component) == name && strings.Contains(string(content), images.KoReference(component)) {
+                        consumed[name] = true
+                    }
+                }
+            }
+            for ref := range m.References {
+                if strings.Contains(string(content), ref) { consumed[ref] = true }
+            }
+            out, err := resolver.ResolveBytes(context.Background(), content)
+            if err != nil { return err }
+            if koRefPattern.Match(out) { t.Errorf("%s: unresolved ko reference", path) }
+            for ref := range m.References {
+                if strings.Contains(string(out), ref) { t.Errorf("%s: unreplaced %s", path, ref) }
+            }
+            return nil
+        })
+        if err != nil { t.Fatal(err) }
+    }
+    // Envoy's placeholder is resolved separately via Pin by the installer.
+    if _, err := resolver.Pin(context.Background(), "envoy-dataplane"); err != nil { t.Fatal(err) }
+    consumed["envoy-dataplane"] = true
+    for name := range m.Images {
+        // Every map name must have a real consumer in the same installTrees
+        // the existing upstream component-coverage test enumerates.
+        if !consumed[name] { t.Errorf("unused component map entry %s", name) }
+    }
+    for ref := range m.References {
+        if !consumed[ref] { t.Errorf("unused third-party map entry %s", ref) }
+    }
+    if len(registry.calls) != 0 { t.Fatalf("registry calls: %v", registry.calls) }
+}
