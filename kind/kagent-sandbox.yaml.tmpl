# A kagent SandboxTemplate whose filesystem is a Nix store path, and the same
# template on an OCI image to compare with. kagent starts its own guest program
# in both; the image only supplies the tools the guest runs.
# Render with envsubst: SANDBOX_NIX_IMAGE is a store path (any Nix actor image
# with a shell, such as `.#kagent-adk-image`), SANDBOX_OCI_IMAGE a
# digest-pinned OCI reference.
apiVersion: api.kagent.dev/v1alpha3
kind: SandboxTemplate
metadata:
  name: sandbox-nix
  namespace: kagent
spec:
  workload:
    image: nix:${SANDBOX_NIX_IMAGE}
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: s3://ate-snapshots/kagent/
---
apiVersion: api.kagent.dev/v1alpha3
kind: SandboxTemplate
metadata:
  name: sandbox-oci
  namespace: kagent
spec:
  workload:
    image: ${SANDBOX_OCI_IMAGE}
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: s3://ate-snapshots/kagent/
