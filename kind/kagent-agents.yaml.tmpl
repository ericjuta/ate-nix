# A Harness that boots kagent's agent runtime from a Nix store path, an Agent
# on it, and the same Agent on kagent's stock OCI harness to compare with.
# Render with envsubst: KAGENT_ADK_IMAGE is the store path of
# `.#kagent-adk-image`, MODEL_CONFIG the name of a ModelConfig in `kagent`.
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: kagent-nix
  namespace: kagent
spec:
  kagent: {}
  workload:
    image: nix:${KAGENT_ADK_IMAGE}
    # The runtime's default, /config, is not writable in a store-path image.
    args: ["--filepath=/tmp/config"]
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: s3://ate-snapshots/kagent/
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata:
  name: assistant-nix
  namespace: kagent
spec:
  template:
    inline:
      modelConfig:
        name: ${MODEL_CONFIG}
      systemPrompt: You are a helpful assistant.
  harnessRef:
    name: kagent-nix
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata:
  name: assistant-oci
  namespace: kagent
spec:
  template:
    inline:
      modelConfig:
        name: ${MODEL_CONFIG}
      systemPrompt: You are a helpful assistant.
  harnessRef:
    name: kagent-default
